---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props {
  title: string;
  theme?: 'dark' | 'light';
  pageBg?: 'dark' | 'light';
}

const { title, theme = 'light', pageBg = theme } = Astro.props;
---

<!doctype html>
<html lang="fr" data-bg={pageBg}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content={pageBg === 'dark' ? '#0d0d0d' : '#fcfaf8'} />
        <link rel="icon" type="image/svg+xml" href="/faviconAd.svg" />
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
        <title>{title}</title>
    </head>
    <body> 
        <Loader />
        <CustomCursor />
        <Header theme={theme}/> 
        <main>
            <slot /> 
        </main>
        <Footer /> 

        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>

        <script>
            import Lenis from 'lenis'

            // Initialisation de Lenis
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                orientation: 'vertical',
                gestureOrientation: 'vertical',
                smoothWheel: true,
            })

            function raf(time: number) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }

            requestAnimationFrame(raf)
        </script>
        <SpeedInsights />
    </body>
</html>