---
import '../styles/contact.css'; 

--- 
 
 <section id="contact">
    <div class="contact-wrapper">
      
      <div class="contact-info ">
        <p class="section-label reveal-left">Parlons de votre projet</p> 
        <h2 class="section-title reveal-left">Demande de devis gratuit</h2>
        <p class="contact-description reveal-left">
          Chaque grand intérieur commence par une conversation. Décrivez-nous votre vision et nous vous répondrons sous 48 heures avec une première proposition.
        </p>
      
      
      <form action="https://formspree.io/f/xykqlqjo" method="POST" class="contact-form reveal-left" id="ajax-contact-form">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Prénom & Nom</label>
            <input type="text" name="nom" placeholder="Votre nom" required class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" name="email" placeholder="votre@email.com" required class="form-input" />
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Téléphone</label>
            <input type="tel" name="telephone" placeholder="+216 52 205 530" class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label">Type de projet</label>
            <div class="select-wrapper">
              <select name="categorie" class="form-select form-input">
                <option value="">Sélectionner…</option>
                <option>Cuisine sur mesure</option>
                <option>Dressing sur mesure</option>
                <option>Mobilier / Kit</option>
                <option>Autre</option>
              </select>
            </div>
          </div>
        </div>
        
        <div class="form-group">
          <label class="form-label">Votre projet</label>
          <textarea name="message" placeholder="Décrivez votre espace, vos envies, votre budget indicatif…" class="form-textarea"></textarea>
        </div>
        
        <div class="form-action">
          <button type="submit" class="btn-text-flip reveal-left">
            <span class="text-default">Envoyer ma demande</span>
            <span class="text-hover">Envoyer ma demande</span>
          </button>
        </div>
          
        <div id="form-status" class="form-status-message"></div>
      </form>
      
    </div>

    <div class="contact-map-container">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3196.2!2d10.1620527!3d36.6714608!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12fd3b9dd89a8567%3A0x5a652ae19dc72053!2sArt%20of%20Design!5e0!3m2!1sfr!2stn!4v1782305828017!5m2!1sfr!2stn"        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div> 

  <!-- script formulaire   -->
<script is:inline>
  // On utilise une fonction auto-exécutée pour isoler le scope
  (() => {
    const initForm = () => {
      const form = document.getElementById('ajax-contact-form');
      const status = document.getElementById('form-status');
      
      if (!form || !status) return;

      form.addEventListener('submit', async (e) => {
        // Bloque immédiatement la redirection native
        e.preventDefault(); 
        e.stopPropagation();

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        // Affichage de l'état de chargement
        status.style.display = 'block';
        status.className = 'form-status-message sending';
        status.innerText = 'Transmission de votre projet...';

        const data = new FormData(form);

        try {
          const response = await fetch(form.action, {
            method: form.method,
            body: data,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            status.className = 'form-status-message success';
            status.innerText = 'Votre message a bien été transmis. Notre équipe vous répondra sous 48 heures.';
            form.reset();
          } else {
            const responseData = await response.json();
            status.className = 'form-status-message error';
            status.innerText = responseData.error || 'Une erreur est survenue.';
            if (submitBtn) submitBtn.disabled = false;
          }
        } catch (error) {
          status.className = 'form-status-message error';
          status.innerText = 'Impossible de joindre le serveur. Veuillez réessayer.';
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    };

    // Gestion du cycle de vie Astro (DOMContentLoaded + transitions de pages éventuelles)
    document.addEventListener('DOMContentLoaded', initForm);
    initForm(); // Exécution immédiate au cas où le DOM est déjà prêt
  })();
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── SCROLL REVEAL ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
  });
</script>