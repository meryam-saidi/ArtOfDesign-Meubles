---
// SwipableGallery.astro
interface GalleryItem {
  src: string;
  alt: string;
  title?: string;
  category?: string;
}

interface CatalogueImageItem {
  image?: string;
  image3d?: string;
}

interface Props {
  images?: (CatalogueImageItem | GalleryItem)[];
} 

const { images = [] } = Astro.props;

// Normalisation et filtrage : On rejette systématiquement les images 3D
const formattedImages = images
  .filter((img) => {
    if ('image3d' in img && !img.image) return false; // Ignore les éléments purement 3D
    return true;
  })
  .map((img) => {
    if ('src' in img) return img; // Déjà formaté

    return {
      src: img.image || '',
      alt: 'Photo de réalisation',
      title: 'Réalisation',
      category: 'Projet Réel'
    };
  })
  .filter((img) => img.src !== ''); // S'assure que l'URL d'image est valide
---

<section class="gallery-wrapper">
  <!-- Header de section minimaliste sans flèches -->
  <div class="gallery-header">
    <div class="header-text">
      <span class="subtitle">Aperçu des Projets</span>
      <h2 class="title">Galerie & Détails</h2>
    </div>
  </div>

  <!-- Container récepteur pour l'effet de survol du curseur -->
  <div class="gallery-interactive-zone" id="interactive-zone">
    <div class="gallery-track" id="gallery-track">
      {formattedImages.map((img, index) => (
        <figure class="gallery-slide" data-index={index}>
          <div class="img-wrapper">
            <img src={img.src} alt={img.alt} loading="lazy" class="slide-img" />
            <div class="img-overlay">
              <button class="zoom-trigger" data-index={index} aria-label="Agrandir">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
              </button>
            </div>
          </div>
          <figcaption class="slide-meta">
            {img.category && <span class="slide-cat">{img.category}</span>}
            {img.title && <h3 class="slide-title">{img.title}</h3>}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Indicateur de progression (affiché uniquement sur mobile) -->
    <div class="gallery-progress" aria-hidden="true">
      <span class="gallery-progress-bar" id="gallery-progress-bar"></span>
    </div>
  </div>

  <!-- Modal Lightbox sur-mesure -->
  <div id="lightbox-modal" class="custom-lightbox" aria-hidden="true">
    <div class="lightbox-overlay"></div>
    <button id="close-btn" class="lb-control close-btn" aria-label="Fermer">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <button id="prev-btn" class="lb-control prev-btn" aria-label="Précédent">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    
    <div class="lightbox-body">
      <img id="lightbox-img" src="" alt="" />
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>

    <button id="next-btn" class="lb-control next-btn" aria-label="Suivant">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<script>
  const track = document.getElementById('gallery-track') as HTMLElement;
  const zone = document.getElementById('interactive-zone') as HTMLElement;

  // Mode mobile : écran étroit OU appareil sans survol (tactile).
  // Même condition que le CSS : le défilement se fait alors au doigt (swipe + snap).
  const mobileMq = window.matchMedia('(max-width: 768px), (hover: none)');

  let animationFrameId: number | null = null;
  let scrollSpeed = 0;

  if (track && zone) {
    zone.addEventListener('mousemove', (e) => {
      // Sur mobile, un tap génère un mousemove « fantôme » qui lancerait un défilement
      // automatique sans fin (mouseleave ne se déclenche jamais) : on désactive l'effet.
      if (mobileMq.matches) return;

      const rect = zone.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const zoneWidth = rect.width;
      
      const centerDeadZone = 0.2;
      const normalizedX = (mouseX / zoneWidth) - 0.5;

      if (Math.abs(normalizedX) > centerDeadZone / 2) {
        const factor = (Math.abs(normalizedX) - centerDeadZone / 2) / (0.5 - centerDeadZone / 2);
        const direction = Math.sign(normalizedX);
        const maxSpeed = 16;
        scrollSpeed = direction * factor * maxSpeed;

        if (!animationFrameId) {
          startScrolling();
        }
      } else {
        stopScrolling();
      }
    });

    zone.addEventListener('mouseleave', () => {
      stopScrolling();
    });

    // Si on bascule en mode mobile (rotation, redimensionnement), on coupe l'auto-scroll
    mobileMq.addEventListener('change', () => stopScrolling());
  }

  function startScrolling() {
    if (track) {
      track.scrollLeft += scrollSpeed;
      animationFrameId = requestAnimationFrame(startScrolling);
    }
  }

  function stopScrolling() {
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }
    scrollSpeed = 0;
  }

  // ── Indicateur de progression (mobile) ──
  const progressBar = document.getElementById('gallery-progress-bar') as HTMLElement | null;
  let progressTicking = false;

  function updateProgress() {
    progressTicking = false;
    if (!track || !progressBar) return;
    const max = track.scrollWidth - track.clientWidth;
    if (max <= 0) {
      progressBar.style.width = '100%';
      progressBar.style.transform = 'translateX(0)';
      return;
    }
    const w = track.clientWidth / track.scrollWidth;
    const ratio = Math.min(1, Math.max(0, track.scrollLeft / max));
    progressBar.style.width = `${w * 100}%`;
    progressBar.style.transform = `translateX(${(ratio * (1 - w) / w) * 100}%)`;
  }

  track?.addEventListener('scroll', () => {
    if (!mobileMq.matches || progressTicking) return;
    progressTicking = true;
    requestAnimationFrame(updateProgress);
  }, { passive: true });

  window.addEventListener('resize', updateProgress);
  updateProgress();

  // ── Glisser à la souris en mode mobile ──
  // Une souris ne fait pas défiler une piste nativement. Sur une fenêtre étroite de PC
  // (ou en mode responsive du navigateur), on active donc le « cliquer-glisser ».
  // Au doigt, le défilement reste 100 % natif.
  let isDragging = false;
  let dragMoved = false;
  let dragStartX = 0;
  let dragStartScroll = 0;

  track?.addEventListener('pointerdown', (e) => {
    if (!mobileMq.matches || e.pointerType !== 'mouse' || e.button !== 0) return;
    isDragging = true;
    dragMoved = false;
    dragStartX = e.clientX;
    dragStartScroll = track.scrollLeft;
  });

  window.addEventListener('pointermove', (e) => {
    if (!isDragging) return;
    const dx = e.clientX - dragStartX;
    if (Math.abs(dx) > 5) {
      dragMoved = true;
      track.classList.add('is-dragging'); // coupe le snap pendant le glissement
    }
    if (dragMoved) track.scrollLeft = dragStartScroll - dx;
  });

  function endDrag() {
    if (!isDragging) return;
    isDragging = false;
    track.classList.remove('is-dragging');

    // Recolle en douceur sur la diapo la plus proche
    if (dragMoved) {
      const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
      const items = Array.from(track.querySelectorAll('.gallery-slide')) as HTMLElement[];
      let target = 0;
      let best = Infinity;
      items.forEach((s) => {
        const left = s.offsetLeft - pad;
        const d = Math.abs(left - track.scrollLeft);
        if (d < best) { best = d; target = left; }
      });
      track.scrollTo({ left: target, behavior: 'smooth' });
    }
  }
  window.addEventListener('pointerup', endDrag);
  window.addEventListener('pointercancel', endDrag);

  // Empêche l'ouverture de la lightbox juste après un glissement
  track?.addEventListener('click', (e) => {
    if (dragMoved) {
      e.stopPropagation();
      e.preventDefault();
      dragMoved = false;
    }
  }, true);

  // Empêche le « glisser-déposer » natif des images
  track?.addEventListener('dragstart', (e) => e.preventDefault());

  const slideElements = Array.from(document.querySelectorAll('.gallery-slide'));
  const slides = slideElements.map(slide => {
    const img = slide.querySelector('.slide-img') as HTMLImageElement;
    const title = slide.querySelector('.slide-title')?.textContent || '';
    return { src: img.src, alt: img.alt, title };
  });

  const modal = document.getElementById('lightbox-modal') as HTMLElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lightbox-caption') as HTMLDivElement;
  const closeBtn = document.getElementById('close-btn');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const overlay = modal?.querySelector('.lightbox-overlay');

  let currentIndex = 0;

  function openLightbox(index: number) {
    stopScrolling();
    currentIndex = index;
    updateModalContent();
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function updateModalContent() {
    currentIndex = (currentIndex + slides.length) % slides.length;
    const item = slides[currentIndex];
    if (item && lbImg && lbCaption) {
      lbImg.src = item.src;
      lbImg.alt = item.alt;
      lbCaption.textContent = item.title || item.alt;

      // Relance la petite animation d'apparition (stylée uniquement sur mobile)
      lbImg.classList.remove('is-switching');
      void lbImg.offsetWidth;
      lbImg.classList.add('is-switching');
    }
  }

  document.querySelectorAll('.zoom-trigger, .img-wrapper').forEach((el) => {
    el.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const index = parseInt(target.closest('.gallery-slide')?.getAttribute('data-index') || '0', 10);
      openLightbox(index);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  overlay?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => { currentIndex--; updateModalContent(); });
  nextBtn?.addEventListener('click', () => { currentIndex++; updateModalContent(); });

  window.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { currentIndex--; updateModalContent(); }
    if (e.key === 'ArrowRight') { currentIndex++; updateModalContent(); }
  });

  // ── Lightbox au doigt (mobile) ──
  // L'image suit le doigt. Relâcher après > 70px change d'image ; sinon elle revient.
  // Glisser vers le bas ferme la lightbox. Pointer Events = doigt, stylet et souris
  // (la souris fonctionne aussi sur une fenêtre étroite). Inactif sur grand écran.
  const lbBody = modal?.querySelector('.lightbox-body') as HTMLElement | null;

  let lbDown = false;
  let lbAxis: 'x' | 'y' | null = null;
  let lbStartX = 0;
  let lbStartY = 0;
  let lbDX = 0;
  let lbDY = 0;
  let lbMoved = false;
  let lbAnimating = false;

  function lbReset(animated: boolean) {
    if (!lbBody) return;
    lbBody.style.transition = animated
      ? 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease'
      : 'none';
    lbBody.style.transform = '';
    lbBody.style.opacity = '';
  }

  modal?.addEventListener('pointerdown', (e) => {
    lbMoved = false;
    if (!mobileMq.matches || !modal.classList.contains('is-open') || lbAnimating) return;
    if ((e.target as HTMLElement).closest('.lb-control')) return;
    lbDown = true;
    lbAxis = null;
    lbDX = 0;
    lbDY = 0;
    lbStartX = e.clientX;
    lbStartY = e.clientY;
  });

  window.addEventListener('pointermove', (e) => {
    if (!lbDown || !lbBody) return;
    lbDX = e.clientX - lbStartX;
    lbDY = e.clientY - lbStartY;

    // Verrouille l'axe dès que le geste dépasse 8px
    if (!lbAxis) {
      if (Math.abs(lbDX) < 8 && Math.abs(lbDY) < 8) return;
      lbAxis = Math.abs(lbDX) > Math.abs(lbDY) ? 'x' : 'y';
    }

    lbMoved = true;
    lbBody.style.transition = 'none';

    if (lbAxis === 'x') {
      lbBody.style.transform = `translateX(${lbDX}px)`;
      lbBody.style.opacity = String(1 - Math.min(Math.abs(lbDX) / (window.innerWidth * 0.9), 0.6));
    } else {
      const dy = Math.max(lbDY, 0); // seul le glissement vers le bas est pris en compte
      lbBody.style.transform = `translateY(${dy}px)`;
      lbBody.style.opacity = String(1 - Math.min(dy / 400, 0.6));
    }
  });

  function lbEnd() {
    if (!lbDown || !lbBody) return;
    lbDown = false;
    if (!lbMoved) return;

    if (lbAxis === 'x' && Math.abs(lbDX) > 70) {
      const dir = lbDX < 0 ? 1 : -1;  // glisser vers la gauche = image suivante
      const out = lbDX < 0 ? -1 : 1;
      lbAnimating = true;

      // 1) l'image sort de l'écran
      lbBody.style.transition = 'transform 0.18s ease-in, opacity 0.18s ease-in';
      lbBody.style.transform = `translateX(${out * window.innerWidth * 0.5}px)`;
      lbBody.style.opacity = '0';

      setTimeout(() => {
        // 2) on change d'image et on la fait entrer du côté opposé
        currentIndex += dir;
        updateModalContent();
        lbImg.classList.remove('is-switching'); // évite le cumul avec l'animation du bouton

        lbBody.style.transition = 'none';
        lbBody.style.transform = `translateX(${-out * 60}px)`;
        void lbBody.offsetWidth;
        lbBody.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease';
        lbBody.style.transform = '';
        lbBody.style.opacity = '';

        setTimeout(() => { lbAnimating = false; }, 300);
      }, 180);
    } else if (lbAxis === 'y' && lbDY > 100) {
      closeLightbox();
      setTimeout(() => lbReset(false), 400); // remet l'état une fois la lightbox fondue
    } else {
      lbReset(true); // geste trop court : l'image revient en place
    }
  }

  window.addEventListener('pointerup', lbEnd);
  window.addEventListener('pointercancel', lbEnd);

  // Un glissement ne doit pas déclencher un clic (fermeture via le fond, par exemple)
  modal?.addEventListener('click', (e) => {
    if (lbMoved) {
      e.stopPropagation();
      e.preventDefault();
      lbMoved = false;
    }
  }, true);

  // Empêche le glisser-déposer natif de l'image à la souris
  modal?.addEventListener('dragstart', (e) => e.preventDefault());
</script>

<style>
  .gallery-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0rem auto 4rem auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .gallery-header {
    margin-bottom: 2rem;
  }

  .subtitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #888;
    display: block;
    margin-bottom: 0.4rem;
  }

  .title {
    font-size: 1.8rem;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .gallery-interactive-zone {
    position: relative;
    width: 100%;
  }

  .gallery-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 1.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .gallery-track::-webkit-scrollbar {
    height: 3px;
  }

  .gallery-track::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 0px;
  }

  .gallery-slide {
    flex: 0 0 85%;
    max-width: 520px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  @media (min-width: 768px) {
    .gallery-slide {
      flex: 0 0 460px;
    }
  }

  .img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 0px;
    overflow: hidden;
    background-color: #121212;
    cursor: inherit;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .img-wrapper:hover .slide-img {
    transform: scale(1.04);
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .img-wrapper:hover .img-overlay {
    opacity: 1;
  }

  .zoom-trigger {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    color: #000;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: inherit;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .img-wrapper:hover .zoom-trigger {
    transform: translateY(0);
  }

  .slide-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .slide-cat {
    font-size: 0.75rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .slide-title {
    font-size: 1.05rem;
    font-weight: 400;
    margin: 0;
  }

  .custom-lightbox,
  .custom-lightbox * {
    cursor: inherit !important;
  }

  .custom-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .custom-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.94);
    backdrop-filter: blur(12px);
  }

  .lightbox-body {
    position: relative;
    z-index: 2;
    max-width: 88vw;
    max-height: 82vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-body img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 0px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    user-select: none;
  }

  .lightbox-caption {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .lb-control {
    position: absolute;
    z-index: 3;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: inherit;
    transition: background 0.25s ease;
  }

  .lb-control:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .close-btn { top: 2rem; right: 2rem; }
  .prev-btn { left: 2rem; top: 50%; transform: translateY(-50%); }
  .next-btn { right: 2rem; top: 50%; transform: translateY(-50%); }

  /* Indicateur de progression : masqué sur desktop */
  .gallery-progress {
    display: none;
  }

  /* ==========================================================================
     GALERIE : MOBILE (écran étroit ou appareil tactile)
     Défilement natif au doigt, avec aimantation (snap) sur chaque diapo.
     ========================================================================== */
  @media (max-width: 768px), (hover: none) {

    /* La piste déborde sur toute la largeur de l'écran (effet « bord à bord ») */
    .gallery-wrapper {
      padding: 0;
      margin: 0 auto 3rem;
    }

    .gallery-header {
      padding: 0 1.25rem;
      margin-bottom: 1.25rem;
    }

    .title {
      font-size: 1.5rem;
    }

    /* Empêche la galerie d'être élargie par son contenu quand elle est dans une grille/flex :
       sans ça, la piste prend la largeur de toutes les images et n'a plus rien à faire défiler */
    .gallery-wrapper,
    .gallery-interactive-zone {
      min-width: 0;
      max-width: 100%;
    }

    /* ── Piste : swipe fluide + snap ── */
    .gallery-track {
      min-width: 0;
      max-width: 100%;
      touch-action: pan-x pan-y; /* autorise explicitement le glissement horizontal et vertical */
      gap: 1rem;
      padding: 0 0 1rem 1.25rem;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 1.25rem;
      overscroll-behavior-x: contain; /* évite le retour arrière du navigateur en fin de piste */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .gallery-track::-webkit-scrollbar {
      display: none;
    }

    /* Pendant un glissement à la souris, le snap est suspendu */
    .gallery-track.is-dragging {
      scroll-snap-type: none;
      user-select: none;
    }

    .slide-img {
      -webkit-user-drag: none;
      user-select: none;
    }

    /* Diapo à 82 % : la suivante dépasse, ce qui invite à glisser */
    .gallery-slide {
      flex: 0 0 82%;
      max-width: 420px;
      scroll-snap-align: start;
      scroll-snap-stop: normal; /* un swipe rapide peut passer plusieurs diapos */
    }

    /* Marge de fin : la dernière diapo peut s'aligner proprement */
    .gallery-slide:last-child {
      margin-right: 1.25rem;
    }

    .slide-title {
      font-size: 1rem;
    }

    /* ── Plus de survol : hover neutralisé ── */
    .slide-img {
      transition: none;
    }

    .img-wrapper:hover .slide-img {
      transform: none;
    }

    /* Le calque sert désormais de simple repère « agrandir » en bas à droite */
    .img-overlay {
      background: transparent;
      opacity: 1;
      align-items: flex-end;
      justify-content: flex-end;
      padding: 0.75rem;
      transition: none;
      pointer-events: none; /* le tap passe à l'image, qui ouvre la lightbox */
    }

    .img-wrapper:hover .img-overlay {
      opacity: 1;
    }

    .zoom-trigger {
      width: 36px;
      height: 36px;
      background: rgba(10, 10, 10, 0.5);
      color: #fff;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transform: none;
      transition: none;
    }

    .img-wrapper:hover .zoom-trigger {
      transform: none;
    }

    .zoom-trigger svg {
      width: 16px;
      height: 16px;
