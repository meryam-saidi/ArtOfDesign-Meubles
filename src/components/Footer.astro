---
import '../styles/footer.css'; 
---

<footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <img src="/images/autres/logo_ADM.png" alt="Logo AD" class="footer-logo-img" />
        <p class="footer-tagline">Meubles de luxe sur mesure. Conception, fabrication et installation en Tunisie depuis 2012.</p>
      </div> 
      <div>
        <p class="footer-col-title">Navigation</p>
        <ul class="footer-links">
          <li><a href="/cuisines">Cuisines</a></li>
          <li><a href="/dressing">Dressings</a></li>
          <li><a href="/meubles">Meubles</a></li>
          <li><a href="/projets">Projets</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-col-title">Informations</p>
        <ul class="footer-links">
          <li><a href="/#about-band">À propos</a></li>
          <li><a href="/projets">Production</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/cuisines-infos">Guide</a></li>
          <!-- <li><a href="/mentions">Mentions légales</a></li>  -->
        </ul>
      </div>
      <div>
        <p class="footer-col-title">Contact</p>
        <div class="contact-details">
          <div class="contact-detail">
            <div>
              <p class="contact-detail-label">Showroom</p>
              <p class="contact-detail-value">Tunis, Tunisie</p>
            </div>
          </div>
          <div class="contact-detail">
            <div>
              <p class="contact-detail-label">Téléphone</p>
              <p class="contact-detail-value">+216 52 205 530</p>
            </div>
          </div>
          <div class="contact-detail">
            <div>
              <p class="contact-detail-label">Email</p>
              <p class="contact-detail-value">contact@artofdesign.tn</p>
            </div>
          </div>
          <div class="contact-detail">
            <div>
              <p class="contact-detail-label">Horaires</p>
              <p class="contact-detail-value">Lun – Sam, 9h – 18h</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">© 2024 Art Of Design Meubles. Tous droits réservés.</p>
      <div class="footer-socials">
        <a href="https://www.instagram.com/art_of_design_meubles?utm_source=ig_web_button_share_sheet&stkn=ZDNlZDc0MzIxNw==" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">ig</a>
        <a href="https://www.facebook.com/ArtofDesignMeuble" class="social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">fb</a>
        <a href="https://www.tiktok.com/@art.ofdesign.meuble?_r=1&_t=ZS-99syO9lbceO" class="social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">TT</a>
      </div>
    </div>
  </footer>