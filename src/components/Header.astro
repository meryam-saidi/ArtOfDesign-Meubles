---
import '../styles/global.css';

// 1. Déclaration de l'interface pour accepter la prop "theme"
interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'light' } = Astro.props;
---

<header 
  id="main-header" 
  class={`header-responsive fixed top-0 left-0 w-full z-50 transition-all duration-500 ${theme === 'dark' ? 'is-dark-theme' : ''}`}
>
  <nav class="max-w-full mx-auto px-6 md:px-12 h-16 md:h-24 flex items-center justify-between navbar-grid">
    
    <div class="nav-left-zone">
      <div id="burger" class="burger-menu md:hidden">
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </div>

      <div id="menu" class="nav-menu">
        <div class="nav-links-wrapper">
          
          <div class="group relative py-4 flex items-center gap-1">
            <a href="/cuisines" class="nav-link">Cuisines</a>
            <div class="dropdown-menu">
              <a href="/cuisines#forme-i" class="dropdown-link">Cuisine Forme I</a>
              <a href="/cuisines#forme-l" class="dropdown-link">Cuisine Forme L</a>
              <a href="/cuisines#forme-u" class="dropdown-link">Cuisine Forme U</a>
              <a href="/cuisines#ilot" class="dropdown-link">Îlot Central</a>
            </div>
          </div>

          <div class="group relative py-4 flex items-center gap-1 cursor-pointer">
            <a href="/dressing" class="nav-link">Dressing</a>
            <div class="dropdown-menu">
              <div class="dropdown-item-wrapper">
                <a href="/dressing#forme-i" class="dropdown-link">Dressing Forme I</a>
                <div class="sous-dropdown-menu">
                  <a href="/dressing#francaise" class="dropdown-link">à la Française</a>
                  <a href="/dressing#coulissant" class="dropdown-link">Coulissant</a>
                </div>
              </div>
              <a href="/dressing#forme-l" class="dropdown-link">Dressing Forme L</a>
            </div>
          </div>

          <div class="group relative py-4 flex items-center gap-1 cursor-pointer">
            <a href="/meubles" class="nav-link">meubles</a>
            <div class="dropdown-menu">
              <a href="/meubles#colonnes" class="dropdown-link">meubles Cuisine</a>
              <a href="/meubles#meuble-dressing" class="dropdown-link">meubles Dressing</a>
            </div>
          </div>

          <a href="/projets" class="nav-link py-4">Réalisations</a>
        </div>

        <div class="mt-auto pt-10 md:hidden w-full">
          <p class="text-[9px] uppercase tracking-widest text-gray-400 mb-2">Besoin d'aide ?</p>
          <a href="tel:+216XXXXXX" class="text-[11px] font-bold text-white">+216 XX XXX XXX</a>
        </div>
      </div>
    </div>

    <div class="nav-center-zone">
      <a href="/" class="z-20 block">
        <img src="/images/autres/logo_ADM.png" alt="Logo AD" class="logo-img" />
      </a>
    </div>

    <div class="nav-right-zone">
      <form action="/search" method="GET" class="relative search-form">
        <input 
          type="text" 
          name="q" 
          placeholder="Recherche..." 
          class="search-input"
        />
        <button type="submit" class="search-button">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </form>
    </div>
    
  </nav>
</header>

<script is:inline>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');

  burger?.addEventListener('click', () => {
    menu?.classList.toggle('active');
    burger?.classList.toggle('open');
  });

  // Gestion simplifiée et performante du scroll via les classes CSS
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  }, { passive: true });
</script>

<!--   -->

<script>
  // le script de filtres existant reste identique
  const setupFilters = () => {
  const buttons = document.querySelectorAll('.filter-btn');
  const sections = document.querySelectorAll<HTMLElement>('.data-catalog-section');

  const filterTo = (targetFilter: string | null, subBlockId: string | null = null) => {
    // 1. Mise à jour de l'état visuel des boutons de filtres principaux
    buttons.forEach(btn => {
      if (btn.getAttribute('data-filter') === targetFilter) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // 2. Affichage / Masquage des sections principales
    sections.forEach(section => {
      const isAllTarget = targetFilter === 'all' && section.id === 'all-gallery';
      const isSpecificTarget = section.id === targetFilter;

      if (isAllTarget || isSpecificTarget) {
        section.style.display = 'block';
        section.style.opacity = '1';

        // 3. Si une sous-catégorie est ciblée (francaise ou coulissant), défiler vers elle
        if (subBlockId) {
          requestAnimationFrame(() => {
            const targetBlock = document.getElementById(subBlockId);
            if (targetBlock) {
              targetBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        }
      } else {
        section.style.display = 'none';
        section.style.opacity = '0';
      }
    });
  };

  // Gestion des clics sur les boutons de filtres sur la page
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const targetFilter = button.getAttribute('data-filter') || 'all';
      filterTo(targetFilter);
      history.pushState(null, '', targetFilter === 'all' ? window.location.pathname : `#${targetFilter}`);
    });
  });

  // Analyse complète de l'URL et du Hash
  const checkHashAndFilter = () => {
    const hash = window.location.hash.replace('#', '');

    if (!hash) {
      filterTo('all');
      return;
    }

    // --- AJOUT : Cas spécifiques pour les sous-menus Dressing ---
    if (hash === 'francaise' || hash === 'coulissant') {
      filterTo('forme-i', hash); // Active la section principale "forme-i" ET scroll vers le sous-bloc
    } 
    // Cas standards pour les autres pages / filtres principaux
    else {
      // Vérifie si la section avec cet ID existe directement
      const directSection = document.getElementById(hash);
      if (directSection && directSection.classList.contains('data-catalog-section')) {
        filterTo(hash);
      } else {
        filterTo('all');
      }
    }
  };

  // Exécution initiale au chargement
  checkHashAndFilter();

  // Écoute les clics depuis le menu déroulant quand on est déjà sur la page
  window.addEventListener('hashchange', checkHashAndFilter);
  };

  document.addEventListener('DOMContentLoaded', setupFilters);
</script>