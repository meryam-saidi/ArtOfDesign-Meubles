---
import '../styles/header.css'; 

// 1. Déclaration de l'interface pour accepter la prop "theme"
interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'light' } = Astro.props;
---
 
<header 
  id="main-header" 
  class={`header-responsive fixed top-0 left-0 w-full z-50 transition-all duration-500 ${theme === 'dark' ? 'is-dark-theme' : ''}`}
>
  <nav class="max-w-full mx-auto px-6 md:px-12 h-16 md:h-24 flex items-center justify-between navbar-grid">
    
    <div class="nav-left-zone">
      <div id="burger" class="burger-menu md:hidden">
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </div>

      <div id="menu" class="nav-menu">
        <div class="nav-links-wrapper">
          
          <div class="group relative py-4 flex items-center gap-1">
            <a href="/cuisines" class="nav-link">Cuisines</a>
            <div class="dropdown-menu">
              <a href="/cuisines#forme-i" class="dropdown-link">Cuisine Forme I</a>
              <a href="/cuisines#forme-l" class="dropdown-link">Cuisine Forme L</a>
              <a href="/cuisines#forme-u" class="dropdown-link">Cuisine Forme U</a>
              <a href="/cuisines#ilot" class="dropdown-link">Îlot Central</a>
            </div>
          </div>

          <div class="group relative py-4 flex items-center gap-1">
            <a href="/dressing" class="nav-link">Dressing</a>
            <div class="dropdown-menu">
              <div class="dropdown-item-wrapper">
                <a href="/dressing#forme-i" class="dropdown-link">Dressing Forme I</a>
                <div class="sous-dropdown-menu">
                  <a href="/dressing#francaise" class="dropdown-link">à la Française</a>
                  <a href="/dressing#coulissant" class="dropdown-link">Coulissant</a>
                </div>
              </div>
              <a href="/dressing#forme-l" class="dropdown-link">Dressing Forme L</a>
            </div>
          </div>

          <div class="group relative py-4 flex items-center gap-1">
            <a href="/meubles" class="nav-link">meubles</a>
            <div class="dropdown-menu">
              <div class="dropdown-item-wrapper">
                <a href="/meubles#colonnes" class="dropdown-link">meubles Cuisine</a>
                <div class="sous-dropdown-menu">
                  <a href="/meubles#colonnes" class="dropdown-link">Meubles Colonne</a>
                  <a href="/meubles#meubles-bas" class="dropdown-link">Meubles Bas</a>
                  <a href="/meubles#meubles-haut" class="dropdown-link">Meubles Haut</a>
                </div>
              </div>
              <a href="/meubles#meubles-dressing" class="dropdown-link">meubles Dressing</a>
            </div>
          </div>

          <a href="/projets" class="nav-link py-4">Réalisations</a>
        </div>

        <div class="mt-2 pt-0 md:hidden w-full">
          <p class="text-[9px] uppercase tracking-widest text-gray-400 mb-2">Besoin d'aide ?</p>
          <a href="tel:+21652205530" class="text-[11px] font-bold text-white">+216 52 205 530</a>
        </div>
      </div>
    </div>

    <div class="nav-center-zone">
      <a href="/" class="z-20 block">
        <img src="/images/autres/logo_ADM.png" alt="Logo AD" class="logo-img" />
      </a>
    </div>

    <div class="nav-right-zone">
      <form action="/search" method="GET" class="relative search-form">
        <input 
          type="text" 
          name="q" 
          placeholder="Recherche..." 
          class="search-input"
        />
        <button type="submit" class="search-button">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </form>
    </div>
    
  </nav>
</header>

<script is:inline>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');

  burger?.addEventListener('click', () => {
    menu?.classList.toggle('active');
    burger?.classList.toggle('open');
  });

  // Gestion simplifiée et performante du scroll via les classes CSS
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  }, { passive: true });
</script>

<!--   -->

<script>
  const setupFilters = () => {
    const buttons = document.querySelectorAll<HTMLElement>('.filter-btn');
    const sections = document.querySelectorAll<HTMLElement>('.data-catalog-section');

    // Page sans catalogue (accueil, etc.) : rien à faire
    if (!sections.length) return;

    // ── Affiche la bonne section et met à jour les boutons ──
    const filterTo = (targetFilter: string) => {
      buttons.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === targetFilter);
      });

      sections.forEach((section) => {
        const visible =
          (targetFilter === 'all' && section.id === 'all-gallery') ||
          section.id === targetFilter;

        section.style.display = visible ? 'block' : 'none';
        section.style.opacity = visible ? '1' : '0';
      });
    };

    // ── Scroll précis, compensé par la hauteur du header fixe ──
    const scrollToEl = (el: Element | null, smooth = false) => {
      if (!el) return;
      const headerH = document.getElementById('main-header')?.offsetHeight ?? 0;
      const y = el.getBoundingClientRect().top + window.scrollY - headerH - 16;
      window.scrollTo({ top: Math.max(0, y), behavior: smooth ? 'smooth' : 'auto' });
    };

    // ── Détermine la section à afficher et l'élément à atteindre pour un hash ──
    const resolveHash = (hash: string) => {
      if (!hash) return { filter: 'all', target: null as Element | null };

      const el = document.getElementById(hash);
      if (!el) return { filter: 'all', target: null };

      // Le hash est une section du catalogue (forme-i, forme-l, colonnes...)
      if (el.classList.contains('data-catalog-section')) {
        return {
          filter: el.id === 'all-gallery' ? 'all' : el.id,
          target: document.querySelector('.catalog-filter-bar') ?? el,
        };
      }

      // Le hash est un sous-bloc (francaise, coulissant...) : on affiche sa section parente
      const parent = el.closest<HTMLElement>('.data-catalog-section');
      if (parent) {
        return {
          filter: parent.id === 'all-gallery' ? 'all' : parent.id,
          target: el,
        };
      }

      return { filter: 'all', target: null };
    };

    // ── Applique le hash, puis re-scrolle quand la hauteur de page se stabilise ──
    const applyHash = (smooth = false) => {
      const hash = window.location.hash.replace('#', '');
      const { filter, target } = resolveHash(hash);

      filterTo(filter);
      if (!target) return;

      // 1er scroll après le rendu
      requestAnimationFrame(() => scrollToEl(target, smooth));

      // Re-scroll quand les images de la section visible ont chargé (la hauteur change)
      const visible = document.getElementById(filter === 'all' ? 'all-gallery' : filter);
      const pending = Array.from(visible?.querySelectorAll('img') ?? []).filter(
        (img) => !img.complete
      );
      if (pending.length) {
        const rescroll = () => scrollToEl(target);
        pending.forEach((img) => img.addEventListener('load', rescroll, { once: true }));
        // Arrêt de sécurité : on ne corrige plus après 2 s
        setTimeout(() => pending.forEach((img) => img.removeEventListener('load', rescroll)), 2000);
      }
    };

    // ── Clics sur les boutons de filtre de la page ──
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetFilter = button.getAttribute('data-filter') || 'all';
        filterTo(targetFilter);
        history.pushState(
          null,
          '',
          targetFilter === 'all' ? window.location.pathname : `#${targetFilter}`
        );
      });
    });

    // ── Chargement initial ──
    // Empêche le navigateur de faire son propre saut d'ancre (sur un élément encore masqué)
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    applyHash();

    // Dernier recalage une fois la page entièrement chargée
    const onLoaded = () => {
      if (window.location.hash) applyHash();
    };
    if (document.readyState === 'complete') onLoaded();
    else window.addEventListener('load', onLoaded, { once: true });

    // ── Navigation depuis le dropdown quand on est déjà sur la page ──
    window.addEventListener('hashchange', () => applyHash(true));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilters);
  } else {
    setupFilters();
  }
</script>
