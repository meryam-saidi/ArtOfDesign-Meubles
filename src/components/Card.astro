---
// src/components/Card.astro
const { type, nom, prix, promo, image, id } = Astro.props;

// On génère l'URL dynamiquement. 
// Routes dynamiques, ce sera `/cuisine/${id}`
const detailUrl = `/${type}/${id || 'demo'}`;

// Calcul du prix après remise
const prixRemise = Math.round(prix * (1 - promo / 100));
---

<a href={detailUrl} class="luxury-cuisine-card">
  {/* VIEWPORT MEDIA */}
  <div class="card-media-wrapper">
    <img src={image} alt={nom} class="card-image" />
    <div class="card-overlay"></div>
  </div>

  {/* BADGE PROMO (OPTIONNEL) */}
  {promo > 0 && (
    <div class="card-badge-promo">
      -{promo}%
    </div>
  )}

  {/* CONTENU EN AVANT-PLAN */}
  <div class="card-content-front">
    <h3 class="card-cuisine-title">{nom}</h3>
    
    <div class="card-prices-box">
      <span class="card-price-discount">{prixRemise} DT</span>
      {promo > 0 && (
        <span class="card-price-original">{prix} DT</span>
      )}
    </div>
  </div>
</a>

<style>
  /* ── CARTE VITRINE CLICABLE ── */
  .luxury-cuisine-card {
    position: relative;
    display: block; /* Indispensable pour une balise <a> */
    width: 100%;
    aspect-ratio: 4 / 3; /* Format vertical ultra-chic pour le design d'intérieur */
    border-radius: 12px;
    overflow: hidden;
    background-color: #bf9f9f9; /* Gris très clair pour un look premium */
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.03);
    /*transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), 
                box-shadow 0.4s cubic-bezier(0.25, 1, 0.5, 1); */
    text-decoration: none;
  }  

  /* ── VIEWPORT DE L'IMAGE ── */
  .card-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); */
  }

  /* Zoom délicat de l'image de fond au hover */
  .luxury-cuisine-card:hover .card-image {
    opacity: 0.9; 
    transform: translateX(0); 
  }

  /* Overlay fondu : transparent en haut, s'assombrit élégamment vers le bas */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13,13,13,0.9) 0%, transparent 60%);
  }

  /* ── BADGE PROMO SOUVRAU ── */
  .card-badge-promo {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 3;
    background-color: #b91c1c; /* Un rouge carmin plus mat et sobre */
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
  }

  /* ── CONTENU TEXTE (En bas au centre) ── */
  .card-content-front {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 2; /* Reste devant l'image et l'overlay */
    padding: 2rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  /* Titre de la cuisine */
  .card-cuisine-title {
    /*font-family: 'Cormorant Garamond', serif;*/
    font-size: 1rem;
    font-weight: 300; 
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  /* Boîtier des prix */
  .card-prices-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .card-price-discount {
    font-size: 1.15rem;
    font-weight: 500;
    color: #ffffff; /* Ton Or signature */
  }

  .card-price-original {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: line-through;
    font-weight: 300;
  }
</style>