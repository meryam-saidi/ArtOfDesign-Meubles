---
// src/components/Card.astro
const { type, nom, prix, promo, image, id } = Astro.props;

// On génère l'URL dynamiquement. 
// Routes dynamiques, ce sera `/cuisine/${id}`
const detailUrl = `/${type}/${id || 'demo'}`;

// Calcul du prix après remise
const prixRemise = Math.round(prix * (1 - promo / 100));
---

<div class="group border border-gray-100 rounded-xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300">
  <div class="relative aspect-video overflow-hidden">
    {promo > 0 && (
      <div class="absolute top-3 right-3 bg-red-600 text-white font-bold px-2 py-1 rounded-md text-sm z-10">
        -{promo}%
      </div>
    )}
    
    <img 
      src={image} 
      alt={nom} 
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
    />
  </div>

  <div class="p-5 text-center">
    <h3 class="text-lg font-medium text-gray-800 mb-2">{nom}</h3>
    
    <div class="flex flex-col items-center gap-1">
      <span class="text-2xl font-bold text-[#b5a264]">{prixRemise} DT</span>
      {promo > 0 && (
        <span class="text-sm text-gray-400 line-through">{prix} DT</span>
      )}
    </div>
    
    <a href={detailUrl} class="block mt-4 w-full py-3 border border-[#b5a264] text-[#b5a264] hover:bg-[#b5a264] hover:text-white transition-all duration-300 rounded-md text-[10px] font-bold uppercase tracking-[0.2em] text-center">
        Voir le projet
    </a>
  </div>
</div>