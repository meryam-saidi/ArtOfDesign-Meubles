---
// src/components/Card.astro
const { type, nom, prix, promo, image, id } = Astro.props;

const detailUrl = `/${type}/${id || 'demo'}`;

const promoValue = Number(promo) || 0;
const hasReduction = promoValue > 0;
const prixRemise = hasReduction 
  ? Math.round(Number(prix) * (1 - promoValue / 100)) 
  : Number(prix);

---

<a href={detailUrl} class="luxury-card">
  {/* BLOC IMAGE AVEC BORDURE FINE */}
  <div class="luxury-media-wrapper">
    <img src={image} alt={nom} class="luxury-img" loading="lazy" />
    
    {/* BADGE PROMO DISCRET EN OR 
    {promo > 0 && (
      <div class="luxury-badge">
        -{promo}%
      </div>
    )}
    */}

    {/* GRADIENT ASSOMBREUR BAS DE CARTE */}
    <div class="luxury-gradient-overlay"></div>
  </div>

  {/* BLOC INFORMATIONS MINIMALISTE */}
  <div class="luxury-info"> 
    <div class="luxury-meta">
      <span class="luxury-type">{type}</span>
      <div class="luxury-prices">
        {hasReduction && <span class="price-old">{prix} DT</span>}
        {hasReduction && <span class="promo">-{promo}%</span>}
        <span class="price-new">{prixRemise} DT</span>
      </div>
    </div>

    <h3 class="luxury-title">{nom}</h3>
    
    {/* LIGNE DE SÉPARATION DÉLICATE AU HOVER */}
    <div class="luxury-line"></div>
  </div>
</a>

<style>
  /* ── STRUCTURE GLOBALE SUR FOND NOIR ── */
  .luxury-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    text-decoration: none;
    /*
    background-color: rgba(255, 255, 255, 0.015);
    border: 0px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    */
    padding: 0.85rem;
    transition: border-color 0.4s ease, transform 0.4s ease, box-shadow 0.4s ease;
    box-sizing: border-box;
  }

  /* Effet de survol : Bordure or très subtile + lueur sombre */
  .luxury-card:hover {
    /*border-color: rgba(201, 168, 76, 0.4);*/
    transform: translateY(-4px);
  }

  /* ── CONTENEUR IMAGE ── */
  .luxury-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    /*background-color: #0d0d0d;*/
  }

  .luxury-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.92) contrast(1.02);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s ease;
  }

  .luxury-card:hover .luxury-img {
    transform: scale(1.04);
    filter: brightness(1);
  }

  /* Degradé pour adoucir le bas de l'image sur le noir */
  .luxury-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 12, 12, 0.6) 0%, transparent 40%);
    pointer-events: none;
  }

  /* ── BADGE PROMO SOMBRE ET OR ── */
  .luxury-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(4px);
    color: var(--gold);
    border: 1px solid rgba(201, 168, 76, 0.3);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.5rem;
    border-radius: 2px;
  }

  /* ── TEXTE ET PRIX ── */
  .luxury-info {
    padding-top: 1rem;
    padding-bottom: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .luxury-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .luxury-type {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold, #c9a84c);
    font-weight: 500;
  }

  .luxury-prices {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .promo {
    font-size: 0.85rem;
    color: var(--gold);
    font-weight: 500;
  }

  .price-new {
    font-size: 0.95rem;
    font-weight: 400;
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  .price-old {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.479);
    text-decoration: line-through;
    font-weight: 400;
  }

  .luxury-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
  }

  .luxury-card:hover .luxury-title {
    color: #ffffff;
  }

  /* Ligne or animée en bas au survol */
  .luxury-line {
    width: 0%;
    height: 1px;
    background: var(--gold, #c9a84c);
    margin-top: 0.25rem;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.7;
  }

  .luxury-card:hover .luxury-line {
    width: 100%;
  }

   @media (max-width: 768px) {
    .luxury-card {
      padding: 0.5rem;
      transition: none;
      transform: none;
    }
 
    /* Plus de soulèvement au survol ; léger retour visuel au toucher à la place */
    .luxury-card:hover {
      transform: none;
      transition: none;
    }
 
    .luxury-card:active {
      opacity: 0.85;
    }
 
    /* Image : pas de zoom ni d'animation de luminosité, affichée à pleine luminosité */
    .luxury-img {
      filter: none;
      transition: none;
      transform: none;
    }
 
    .luxury-card:hover .luxury-img {
      transform: none;
      transform: none;
      filter: none;
    }
 
    /* Infos */
    .luxury-info {
      padding-top: 0.75rem;
      padding-bottom: 0.25rem;
      gap: 0.35rem;
    }
 
    /* Type et prix : sur une ligne si ça tient, sinon les prix passent dessous */
    .luxury-meta {
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
    }
 
    .luxury-type {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
    }
 
    .luxury-prices {
      flex-wrap: wrap;
      gap: 0.25rem 0.6rem;
    }
 
    .price-new {
      font-size: 1rem;
    }
 
    .price-old,
    .promo {
      font-size: 0.8rem;
    }
 
    .luxury-title {
      font-size: 1.15rem;
      line-height: 1.25;
      transition: none;
    }
 
    .luxury-card:hover .luxury-title {
      color: rgba(255, 255, 255, 0.9);
    }
 
    /* Ligne dorée : n'apparaît qu'au survol sur desktop, donc inutile au toucher */
    .luxury-line,
    .luxury-card:hover .luxury-line {
      display: none;
    }
  }
</style>