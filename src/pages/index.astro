        { n: '01', title: 'Consultation', desc: 'Rendez-vous découverte pour comprendre vos besoins, votre style et votre espace.' },
        { n: '02', title: 'Design 3D', desc: 'Visualisation complète de votre projet avant le début de la fabrication.' },
