  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Art <em>Of</em> Design</a>
        <p class="footer-tagline">Meubles de luxe sur mesure. Conception, fabrication et installation en Tunisie depuis 2012.</p>
      </div>
      <div>
        <p class="footer-col-title">Navigation</p>
        <ul class="footer-links">
          <li><a href="/cuisines">Cuisines</a></li>
          <li><a href="/dressings">Dressings</a></li>
          <li><a href="/meubles">Mobilier</a></li>
          <li><a href="/projets">Projets</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-col-title">Univers</p>
