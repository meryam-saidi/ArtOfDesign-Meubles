    </div>
    <div class="swiper meubleSwiper">
      <div class="swiper-wrapper">
        {meubles.map((item) => (
          <div class="swiper-slide">
            <Card type="meuble" id={item.id} nom={item.nom} prix={item.prix_initial} promo={item.reduction} image={item.image} />
