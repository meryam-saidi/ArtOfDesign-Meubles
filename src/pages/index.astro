---
/**index.astro */
import Layout from '../layouts/Layout.astro';
import cuisinesData from '../data/cuisines.json';
import dressingData from '../data/dressing.json';
import meublesData from '../data/meuble.json';
import projetsData from '../data/projets.json';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import '../styles/index.css'; 

const cuisines = cuisinesData.filter(item => item.categorie === "Cuisines");
const dressing = dressingData;
const meubles = meublesData;
const projets = projetsData;

const categories = [
  { id: 'cuisines',    label: 'Cuisines',       sub: 'Design exclusif',       image: '/images/autres/categorieKitchen.png',   link: '/cuisines' },
  { id: 'dressings',  label: 'Dressings',       sub: 'Élégance pure',    image: '/images/autres/categorieDressing.png',   link: '/dressing' },
  { id: 'meubles',    label: 'Meubles',        sub: 'Sur mesure',  image: '/images/autres/meubles_categorie.png',   link: '/meubles' },
  /*{ id: 'projets',    label: 'Projets',         sub: 'Découvrir Nos Projets',  image: '/images/autres/project_categorie.jpg',   link: '/projets' },
*/
  ];

const stats = [
  { number: '12+', label: 'Années d\'excellence' },
  { number: '800+', label: 'Projets réalisés' },
  { number: '100%', label: 'Sur mesure' },
  { number: '48h', label: 'Délai de réponse' },
];
---

<Layout title="Art Of Design | Meubles de Luxe sur Mesure" pageBg="dark">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" />
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Philosopher:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

  <section id="hero">
    <div class="hero-bg">
      <video autoplay muted loop playsinline>
        <source src="/videos/hero_video.mp4" type="video/mp4" />
        Votre navigateur ne supporte pas la vidéo.
      </video>
    </div>
    
    <div class="hero-overlay"></div>
    
    <div class="hero-content"> 
      <div class="hero-left">
        <p class="hero-eyebrow">Art Of Design — Fondé 2016</p>
        <h1 class="hero-headline">
          l'art du beau intérieur
        </h1>
      </div>
      
      <div class="hero-right">
        <p class="hero-desc">
          Chaque espace mérite d'être pensé avec soin. Nous créons des meubles sur mesure qui allient matériaux nobles, savoir-faire artisanal et esthétique intemporelle.
        </p>
        <div class="hero-actions">
          <a href="#categories-simple-section" class="btn-text-flip">
              <span class="text-default">Explorer nos univers</span>
              <span class="text-hover">Explorer nos univers</span>
          </a>
          <a href="#contact" class="btn-text-flip">  
              <span class="text-default">Prendre RDV</span>
              <span class="text-hover">Prendre RDV</span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-scroll">
      <div class="scroll-line"></div>
    </div>
  </section>

  <section id="about-band" class="about-band-section">
    <div class="about-band-container">
      <span class="section-header-eyebrow reveal">A propos de Art Of Design</span>
      
      <h2 class="section-header-title reveal">
        L'harmonie absolue entre l'Art & l'ingénierie d'espace
      </h2>
      
      <p class="about-band-text reveal">
        Nous façonnons des cuisines de haute facture, des dressings sur mesure et du mobilier d'exception. <br />
        Chaque création marie les standards de précision les plus stricts à une esthétique intemporelle et unique.
      </p>
      
      <div class="about-band-stats ">
        <div class="band-stat reveal">
          <span class="band-stat-number">10+</span>
          <span class="band-stat-label">Ans d'Artistry</span>
        </div>
        <div class="band-stat-divider"></div>
        <div class="band-stat reveal">
          <span class="band-stat-number">300+</span>
          <span class="band-stat-label">Projets Signés</span>
        </div>
        <div class="band-stat-divider"></div>
        <div class="band-stat reveal">
          <span class="band-stat-number">100%</span>
          <span class="band-stat-label">Sur Mesure</span>
        </div>
      </div>
    </div>
  </section>

  <!-- On crée un wrapper qui gère l'effet de calque sans toucher à la structure globale -->
  <section id="philosophy-premium" class="w-full">
    <div class="philosophy-container">
      
      <div class="philosophy-media reveal-left">
        <div class="image-wrapper">
          <img src="/images/autres/philo_section.png" alt="Moodboard matières" />
        </div>
      </div>

      <div class="philosophy-content">
        <div class="philosophy-header">  
          <span class="section-header-eyebrow reveal-right">Notre philosophie</span> <!-- — --> 
          <h2 class="section-header-title reveal-right">
            Le mobilier comme expression de soi
          </h2>
        </div>
        
        <div class="philosophy-text reveal-right">
          <p>Chez <strong>Art Of Design</strong>, votre intérieur est le reflet de votre personnalité. Chaque projet naît d'une écoute approfondie de votre mode de vie pour aboutir à une création unique.<br/>
          Notre philosophie prend vie à travers ce dialogue subtil entre vos aspirations et la matière brute.</p>
        </div>
        <div class="philosophy-action reveal-right">
          <a href="#categories-pin-container" class="btn-text-flip"> 
            <span class="text-default">Explorer nos univers</span>
            <span class="text-hover">Explorer nos univers</span>
          </a>
          <a href="#contact" class="btn-text-flip">
            <span class="text-default">Prendre RDV</span>
            <span class="text-hover">Prendre RDV</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <section id="categories-simple-section" class="w-full">
    <div class="categories-grid-container">
      
      <div class="categories-simple-header ">
        <span class="section-header-eyebrow reveal">Nos univers</span>
        <h2 class="section-header-title reveal">Trois collections, une exigence</h2>
      </div>

      <div class="categories-simple-grid">
        {categories.map((cat) => (
          <a href={cat.link} class="category-simple-card group reveal">
            <div class="category-simple-media">
              <img src={cat.image} alt={cat.label} loading="lazy" />
              <div class="category-simple-overlay"></div>
            </div>
            <div class="category-simple-info">
              <!-- <h3 class="category-simple-title">{cat.label}</h3> -->
              <span class="category-simple-link">
                <span>{cat.label}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <Process/>

  
  
  <Contact/>

  

</Layout>



<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── SCROLL REVEAL ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
  });
</script>

