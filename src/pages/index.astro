  <div class="marquee-section">
    <div class="marquee-track">
      {['Cuisines', 'Dressings', 'Unités TV', 'Chambres', 'Home Office', 'Mobilier Kit', 'Design 3D Offert', 'Sur Mesure', 'Fabrication Locale'].flatMap(t => [
        <span class="marquee-item">{t}</span>,
        <span class="marquee-item marquee-dot">✦</span>
      ])}
