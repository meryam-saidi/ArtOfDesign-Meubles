---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import cuisinesData from '../data/cuisines.json';
import dressingData from '../data/dressing.json';
import meublesData from '../data/meubles.json';
import projetsData from '../data/projets.json';
import Header from '../components/Header.astro';

const cuisines = cuisinesData.filter(item => item.categorie === "Nos Cuisines");
const dressing = dressingData;
const meubles = meublesData;
const projets = projetsData;

const categories = [
  { id: 'cuisines',    label: 'Cuisines',       sub: 'Sur mesure',       image: '/images/kitchen_categorie.jpg',   link: '/cuisines' },
  { id: 'dressings',  label: 'Dressings',       sub: 'Élégance pure',    image: '/images/dressing_categorie.jpg',   link: '/dressings' },
  { id: 'meubles',    label: 'Mobilier',        sub: 'Design exclusif',  image: '/images/meubles_categorie.png',   link: '/meubles' },
  { id: 'projets',    label: 'Projets',         sub: 'Découvrir Nos Projets',  image: '/images/project_categorie.jpg',   link: '/projets' },
];

const stats = [
  { number: '12+', label: 'Années d\'excellence' },
  { number: '800+', label: 'Projets réalisés' },
  { number: '100%', label: 'Sur mesure' },
  { number: '48h', label: 'Délai de réponse' },
];
---

<Layout title="Art Of Design | Meubles de Luxe sur Mesure">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" />
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>



  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <div id="loader">
    <p class="loader-logo">Art <em>Of</em> Design</p>
    <div class="loader-line"></div>
    <p class="loader-sub">Meubles de luxe sur mesure — Tunisie</p>
  </div>

  <section id="hero">
    <div class="hero-bg">
      <video autoplay muted loop playsinline>
        <source src="/videos/hero_video.mp4" type="video/mp4" />
        Votre navigateur ne supporte pas la vidéo.
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-left">
        <p class="hero-eyebrow">Art Of Design — Fondé 2012</p>
        <h1 class="hero-headline">
          L'art du<br /><em>beau</em><br />intérieur
        </h1>
      </div>
      <div class="hero-right">
        <p class="hero-desc">
          Chaque espace mérite d'être pensé avec soin. Nous créons des meubles sur mesure qui allient matériaux nobles, savoir-faire artisanal et esthétique intemporelle.
        </p>
        <div class="hero-actions">
          <a href="#categories-pin-container" class="btn-primary">Explorer nos univers</a>
          <a href="#contact" class="btn-ghost">Prendre RDV</a>
        </div>
      </div>
    </div>
    <div class="hero-scroll">
      <span>Défiler</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  

  <section id="philosophy">
    <div class="philosophy-image reveal-left">
      <img src="/images/philo_section.png" alt="Savoir-faire artisanal" />

    </div> 
    <div class="reveal-right">
      <p class="section-label">Notre philosophie</p>
      <h2 class="section-title">
       <br /><em> Le mobilier comme expression de soi</em>
      </h2>
      <div class="philosophy-divider"></div>
      <p>
        Chez Art Of Design, nous croyons que votre interior est le reflet de votre personnalité. Chaque projet commence par une écoute approfondie — vos envies, votre mode de vie, vos contraintes — pour aboutir à une création unique qui vous ressemble.
      </p>
      <p>
        De la première esquisse au rendu 3D, jusqu'à l'installation finale, notre équipe vous accompagne à chaque étape avec passion et précision.
      </p>
      <br />
      <a href="/projets" class="btn-primary">Voir nos réalisations</a>
    </div>
  </section>

<section id="categories-pin-container" class="w-full overflow-hidden">
    <div class="h-screen w-full flex flex-col justify-center relative py-12">
      
      <div class="px-12 max-w-7xl mx-auto w-full mb-12">

      </div>

      <div class="categories-horizontal-track">
        {categories.map((cat) => (
          <a href={cat.link} class="cat-card group">
            <div class="cat-card-img-wrapper">
              <img 
                src={cat.image} 
                alt={cat.label} 
                loading="lazy" 
              />
              <div class="cat-card-overlay-gradient"></div>
            </div>
            
            <div class="cat-card-text-content">
              <span class="cat-card-sub-label">{cat.sub}</span>
              <h3 class="cat-card-title-label">{cat.label}</h3>
              <div class="cat-card-action">
                Découvrir <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <section id="stats">
    {stats.map((s) => (
      <div class="stat-item reveal">
        <div class="stat-number">{s.number}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </section>

  <section class="product-section">
    <div class="product-section-header">
      <div class="section-tag">
        <span class="section-tag-label"><a href="/cuisines" style="color:inherit;text-decoration:none">Cuisines</a></span>
        <div class="section-line"></div>
      </div>
      <div class="swiper-controls">
        <button class="swiper-btn swiper-prev-cuisine" aria-label="Précédent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="swiper-btn swiper-next-cuisine" aria-label="Suivant">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    <div class="swiper cuisineSwiper">
      <div class="swiper-wrapper">
        {cuisines.map((item) => (
          <div class="swiper-slide">
            <Card type="cuisine" id={item.id} nom={item.nom} prix={item.prix_initial} promo={item.reduction} image={item.image} />
          </div>
