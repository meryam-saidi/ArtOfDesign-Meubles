        { text: "L'équipe a su transformer notre espace en quelque chose de véritablement exceptionnel. Le suivi du projet était irréprochable.", author: "Karim A.", loc: "Sousse", stars: "★★★★★" },
        { text: "Notre dressing est maintenant une pièce à vivre. Les matériaux choisis, les finitions… tout respire la qualité et le raffinement.", author: "Leila M.", loc: "Sfax", stars: "★★★★★" },
      ].map((t) => (
        <div class="testimonial-card reveal">
          <div class="testimonial-stars">{t.stars}</div>
          <p class="testimonial-text">« {t.text} »</p>
          <p class="testimonial-author"><strong>{t.author}</strong> — {t.loc}</p>
