---
import Layout from '../layouts/Layout.astro';
import cuisinesData from '../data/cuisines.json';
import dressingData from '../data/dressing.json';
import meublesData from '../data/meuble.json';
import projetsData from '../data/projets.json';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import '../styles/index.css'; 

const cuisines = cuisinesData.filter(item => item.categorie === "Cuisines");
const dressing = dressingData;
const meubles = meublesData;
const projets = projetsData;

const categories = [
  { id: 'cuisines',    label: 'Cuisines',       sub: 'Design exclusif',       image: '/images/autres/categorieKitchen.png',   link: '/cuisines' },
  { id: 'dressings',  label: 'Dressings',       sub: 'Élégance pure',    image: '/images/autres/categorieDressing.png',   link: '/dressings' },
  { id: 'meubles',    label: 'Meubles',        sub: 'Sur mesure',  image: '/images/autres/meubles_categorie.png',   link: '/meubles' },
  /*{ id: 'projets',    label: 'Projets',         sub: 'Découvrir Nos Projets',  image: '/images/autres/project_categorie.jpg',   link: '/projets' },
*/
  ];

const stats = [
  { number: '12+', label: 'Années d\'excellence' },
  { number: '800+', label: 'Projets réalisés' },
  { number: '100%', label: 'Sur mesure' },
  { number: '48h', label: 'Délai de réponse' },
];
