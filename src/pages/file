loader script
<script>
  import { gsap } from 'gsap';

  window.addEventListener('load', () => {
    setTimeout(() => {
      const loader = document.getElementById('loader');
      const loaderLogo = document.getElementById('loader-logo-animated');
      const headerLogo = document.getElementById('header-logo-target');
      const loaderSub = document.querySelector('.loader-sub');
      const loaderLine = document.querySelector('.loader-line');

      if (!loader || !loaderLogo || !headerLogo) return;

      // 1. CALCUL DES COORDONNÉES (On calcule l'écart pour ramener le header au centre)
      const targetRect = headerLogo.getBoundingClientRect();
      const currentRect = loaderLogo.getBoundingClientRect();

      // Centres exacts
      const currentCenterX = currentRect.left + currentRect.width / 2;
      const currentCenterY = currentRect.top + currentRect.height / 2;
      const targetCenterX = targetRect.left + targetRect.width / 2;
      const targetCenterY = targetRect.top + targetRect.height / 2;

      // Distance pour déplacer le logo du HEADER vers le CENTRE du loader
      const startX = currentCenterX - targetCenterX;
      const startY = currentCenterY - targetCenterY;

      // Ratios d'échelle inverse (combien de fois le logo du header doit grandir pour imiter le loader)
      const startScale = currentRect.width / targetRect.width;

      // 2. CONFIGURATION INITIALE DE GSAP
      // On place instantanément le logo du header au centre, géant, invisible pour l'instant
      gsap.set(headerLogo, {
        x: startX,
        y: startY,
        scale: startScale,
        transformOrigin: "50% 50%",
        opacity: 0
      });

      // 3. LA TIMELINE D'ANIMATION
      const tl = gsap.timeline({
        onComplete: () => {
          loader.style.display = 'none';
          // Nettoyage complet pour que le header redevienne normal et responsive
          gsap.set(headerLogo, { clearProps: "all" });
        }
      });

      // Séquence classique du loader
      tl.fromTo([loaderLogo, loaderSub], 
        { opacity: 0}, 
        { opacity: 1, y: 0, duration: 0.6, ease: "power2.out", stagger: 0.15 }
      )
      .fromTo(loaderLine, 
        { scaleX: 0 }, 
        { scaleX: 1, duration: 1.2, ease: "power2.inOut", transformOrigin: "center center" },
        "-=0.2"
      )
      .to([loaderSub, loaderLine], {
        opacity: 0,
        duration: 0.3,
        ease: "power2.in"
      })
      
      // 4. LE TWIST VISUEL (FONDU CROISÉ SUR PLACE)
      // On affiche le logo du header au centre et on cache celui du loader simultanément
      .to(headerLogo, { opacity: 1, duration: 0.1 })
      .to(loaderLogo, { opacity: 0, duration: 0.1 }, "-=0.1")

      // 5. L'ENVOL VERS SA POSITION FINALE (Le logo du header rentre à la maison)
      .to(headerLogo, {
        x: 0,
        y: 0,
        scale: 1,
        duration: 1.4,
        ease: "power4.inOut"
      }, "voyage") // Un micro-arrêt au centre pour stabiliser le regard

      // Le fond noir s'efface pendant le voyage
      .to(loader, {
        opacity: 0,
        duration: 0.8,
        ease: "power2.inOut"
      }, "voyage+=0.4");

    }, 100);
  });
</script>

