<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  // ── CURSOR ──
  const cursor = document.getElementById('cursor');
  const ring = document.getElementById('cursorRing');
  let mouseX = 0, mouseY = 0, ringX = 0, ringY = 0;
  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX; mouseY = e.clientY;
    cursor.style.left = mouseX + 'px';
    cursor.style.top = mouseY + 'px';
  });
  function animateRing() {
    ringX += (mouseX - ringX) * 0.12;
    ringY += (mouseY - ringY) * 0.12;
    ring.style.left = ringX + 'px';
    ring.style.top = ringY + 'px';
    requestAnimationFrame(animateRing);
  }
  animateRing();

  // ── LOADER ──
  const loader = document.getElementById('loader');
  setTimeout(() => {
    loader.style.transition = 'opacity 0.8s ease';
    loader.style.opacity = '0';
    setTimeout(() => loader.style.display = 'none', 800);
  }, 2400);

  // ── NAV SCROLL ──
  const nav = document.getElementById('navbar');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 60);
    });
  }

  // ── SCROLL REVEAL ──
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));

  // ── SWIPERS PRODUITS ──
  const commonConfig = {
    spaceBetween: 24,
    loop: true,
    breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
    slidesPerView: 1,
  };

  new Swiper('.cuisineSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-cuisine', prevEl: '.swiper-prev-cuisine' } });
  new Swiper('.dressingSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-dressing', prevEl: '.swiper-prev-dressing' } });
  new Swiper('.meubleSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-meuble', prevEl: '.swiper-prev-meuble' } });
  new Swiper('.projetSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-projet', prevEl: '.swiper-prev-projet' } });

});
</script>

<script is:inline>
  function initHorizontalScroll() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      
      gsap.registerPlugin(ScrollTrigger);

      const track = document.querySelector('.categories-horizontal-track');
      const container = document.querySelector('#categories-pin-container');
      const cards = gsap.utils.toArray('.cat-card'); // Récupère toutes tes cartes sous forme de tableau
      
      if (!track || !container || cards.length === 0) return;

      // ÉTAPE 1 : Le calcul de distance pour du 100% plein écran
      // On doit glisser de la largeur totale des cartes MOINS la première qui est déjà visible à l'écran.
      const getScrollAmount = () => {
        return -(track.scrollWidth - window.innerWidth);
      };

      // ÉTAPE 2 : Création de l'animation
      gsap.to(track, {
        x: getScrollAmount,
        ease: "none", 
        scrollTrigger: {
          trigger: container,
          start: "top top",      // Épingle dès que le conteneur touche le haut de l'écran
          end: () => `+=${track.scrollWidth}`, // Durée du scroll proportionnelle à la frise entière
          pin: true,             // Bloque le scroll vertical
          scrub: 1,              // Fluidité de suivi du mouvement (1 = 1 seconde d'inertie douce)
          invalidateOnRefresh: true,
          
          // ÉTAPE 3 : L'aimantage (Snap) - Indispensable pour le 100% de largeur
          // Permet de forcer la carte à se caler parfaitement à l'écran si l'utilisateur s'arrête entre deux images
          snap: {
            snapTo: 1 / (cards.length - 1), // Divise la progression du scroll équitablement par carte
            duration: { min: 0.2, max: 0.6 }, // Vitesse de l'ajustement automatique
            ease: "power1.inOut"
          }
        }
      });

      ScrollTrigger.refresh();
    }
  }

  // Initialisation au chargement de la page et des médias
  window.addEventListener('load', () => {
    setTimeout(initHorizontalScroll, 250);
  });
</script>



