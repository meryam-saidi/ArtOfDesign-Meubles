<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  // Cursor
  const cur = document.getElementById('cur');
  const ring = document.getElementById('curRing');
  let mx=0,my=0,rx=0,ry=0;
  document.addEventListener('mousemove',e=>{ mx=e.clientX; my=e.clientY; cur.style.left=mx+'px'; cur.style.top=my+'px'; });
  (function a(){ rx+=(mx-rx)*.1; ry+=(my-ry)*.1; ring.style.left=rx+'px'; ring.style.top=ry+'px'; requestAnimationFrame(a); })();

  // Loader
  const loader=document.getElementById('loader');
  setTimeout(()=>{ loader.style.transition='opacity .7s ease'; loader.style.opacity='0'; setTimeout(()=>loader.style.display='none',700); },2200);

  // Nav scroll
  const nav=document.getElementById('nav');
  window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>60));

  // Scroll reveal
  const io=new IntersectionObserver(entries=>{ entries.forEach((e,i)=>{ if(e.isIntersecting){ setTimeout(()=>e.target.classList.add('in'),i*80); io.unobserve(e.target); } }); },{ threshold:.1 });
  document.querySelectorAll('.rv,.rvl,.rvr').forEach(el=>io.observe(el));

  // Swipers
  const cfg={ spaceBetween:20, slidesPerView:1, loop:true, breakpoints:{ 768:{slidesPerView:2}, 1100:{slidesPerView:3} } };
  new Swiper('.sw-c',{ ...cfg, navigation:{ nextEl:'.pc-next', prevEl:'.pc-prev' } });
  new Swiper('.sw-d',{ ...cfg, navigation:{ nextEl:'.pd-next', prevEl:'.pd-prev' } });
  new Swiper('.sw-m',{ ...cfg, navigation:{ nextEl:'.pm-next', prevEl:'.pm-prev' } });
  new Swiper('.sw-p',{ ...cfg, navigation:{ nextEl:'.pp-next', prevEl:'.pp-prev' } });
});
</script>