<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const swatches = document.querySelectorAll('.color-swatch');
    const colorLabel = document.getElementById('color-label') as HTMLElement | null;
    const previewCard = document.getElementById('texture-preview-card') as HTMLElement | null;
    const defaultSwatch = Array.from(swatches).find(s => s.getAttribute('title') === "Chêne naturel") as HTMLElement | null;

    // SI L'ÉLÉMENT N'EXISTE PAS SUR CETTE PAGE, ON QUITTE SILENCIEUSEMENT SANS ERREUR
    if (!previewCard) return;

    let activeSwatch: HTMLElement | null = null;

    if (defaultSwatch) {
      const defaultImg = defaultSwatch.getAttribute('data-value');
      const defaultTitle = defaultSwatch.getAttribute('title') || '';

      if (defaultImg && previewCard) {
        // 1. On applique directement le titre et la texture en arrière-plan
        if (colorLabel) colorLabel.textContent = defaultTitle;
        previewCard.style.backgroundImage = `url(${defaultImg})`;
        
        // 2. On fait descendre le rectangle instantanément ou via une transition douce
        gsap.to(previewCard, {
          y: "0%",
          duration: 0.45,
          ease: "power3.out"
        });

        // 3. On l'enregistre comme la pastille active en mémoire
        activeSwatch = defaultSwatch;
      }
    }

    function closePreview() {
      if (!previewCard) return;
      
      gsap.to(previewCard, {
        y: "-100%",
        duration: 0.3,
        ease: "power2.in",
        onComplete: () => {
          if (colorLabel) colorLabel.textContent = "";
          swatches.forEach(s => s.classList.remove('active-swatch'));
          activeSwatch = null;
        }
      });
    }

    function openOrChangePreview(currentSwatch: HTMLElement, imageUrl: string, title: string) {
      if (!previewCard) return;
      
      const tl = gsap.timeline();

      if (activeSwatch && activeSwatch !== currentSwatch) {
        tl.to(previewCard, {
          y: "-100%",
          duration: 0.2,
          ease: "power2.in",
          onComplete: () => {
            if (colorLabel) colorLabel.textContent = title;
            previewCard.style.backgroundImage = `url(${imageUrl})`;
          }
        });
      } else {
        if (colorLabel) colorLabel.textContent = title;
        previewCard.style.backgroundImage = `url(${imageUrl})`;
      }

      tl.to(previewCard, {
        y: "0%",
        duration: 0.45,
        ease: "power3.out"
      });

      swatches.forEach(s => s.classList.remove('active-swatch'));
      currentSwatch.classList.add('active-swatch');
      activeSwatch = currentSwatch;
    }

    swatches.forEach(swatch => {
      swatch.addEventListener('click', (e) => {
        const currentSwatch = e.currentTarget as HTMLElement;
        const imageUrl = currentSwatch.getAttribute('data-value');
        const title = currentSwatch.getAttribute('title') || '';

        if (!imageUrl) return;

        if (activeSwatch === currentSwatch) {
          closePreview();
        } else {
          openOrChangePreview(currentSwatch, imageUrl, title);
        }
      });
    });
  });
</script>


<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('main-visual') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn');
    const rail = document.getElementById('thumb-rail');
    const mask = document.getElementById('slider-mask');
    const prevBtn = document.getElementById('slide-prev');
    const nextBtn = document.getElementById('slide-next');

    if (!rail || !mask) return;

    // 1. INITIALISATION DU DRAGGABLE
    const dragInstance = Draggable.create(rail, {
      type: "x",
      bounds: mask,
      edgeResistance: 0.65,
      inertia: true,
    })[0]; // On récupère l'instance indexée 0

    // 2. LOGIQUE DE NAVIGATION VIA LES FLÈCHES
    // Largeur d'une miniature (9rem = 144px) + gap (0.5rem = 8px) = ~152px
    const stepWidth = 152; 

    function moveSlider(direction: 'next' | 'prev') {
      // On calcule la position cible X actuelle
      let currentX = gsap.getProperty(rail, "x") as number;
      let targetX = direction === 'next' ? currentX - stepWidth : currentX + stepWidth;

      // Force GSAP à respecter les limites physiques (bounds) du masque de défilement
      const minX = dragInstance.minX;
      const maxX = dragInstance.maxX;

      if (targetX < minX) targetX = minX;
      if (targetX > maxX) targetX = maxX;

      // Animation fluide du rail vers la nouvelle position
      gsap.to(rail, {
        x: targetX,
        duration: 0.4,
        ease: "power2.out",
        onUpdate: () => dragInstance.update() // Synchronise l'état interne du Drag de GSAP
      });
    }

    nextBtn?.addEventListener('click', () => moveSlider('next'));
    prevBtn?.addEventListener('click', () => moveSlider('prev'));

    // 3. LOGIQUE DE CHANGEMENT DE GALERIE (FADE)
    function updateGallery(newSrc: string | null) {
      if (!mainImg || !newSrc) return;
      
      gsap.to(mainImg, {
        opacity: 0,
        duration: 0.2,
        onComplete: () => {
          mainImg.src = newSrc;
          gsap.to(mainImg, { opacity: 1, duration: 0.2 });
        }
      });
    }

    thumbButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const currentBtn = e.currentTarget as HTMLElement;
        const img = currentBtn.getAttribute('data-full');
        
        updateGallery(img);

        thumbButtons.forEach(b => b.classList.remove('active-thumb'));
        currentBtn.classList.add('active-thumb');
      });
    });
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── SCROLL REVEAL ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
  });
</script>


