---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import meublesData from '../data/meuble.json';
import '../styles/cuisines.css'; 

// On définit les sections que l'on veut afficher
const sections = [
  { id: "colonnes", label: "meubles Colonne de Cuisine", valeur: "C" },
  { id: "meubles-bas", label: "meubles Bas de Cuisine", valeur: "B" },
  { id: "meubles-haut", label: "meubles Haut de Cuisine", valeur: "H" },
  { id: "meubles-dressing", label: "meubles Dressing", valeur: "D" }
];

const toutesLesDressingMixees = [...meublesData].sort(() => 0.5 - Math.random());
---

<Layout title="Nos Modèles de meubles | Art Of Design" pageBg="dark">
  <main class="luxury-catalog">
    
    <!-- LUXURY HERO -->
    <section class="luxury-hero">
      <div class="luxury-hero-bg">
        <img 
          src="/images/autres/kit caisson 2.png" 
          alt="Art Of Design Haute meuble" 
          class="luxury-hero-img"
        />
        <div class="luxury-hero-overlay"></div>
      </div>
      
      <div class="luxury-hero-content">
        <h1 class="luxury-main-title">
          Éléments Configurables
        </h1>
        <p class="luxury-text">Colonnes, Meubles hauts, Meubles bas — <br/>composez votre meuble ou dressing module par module avec la même qualité que nos réalisations complètes.</p>
        <p class="luxury-subtitle">Collection Meubles</p>
      </div>
    </section>

    <!-- BARRE DE NAVIGATION ET FILTRES -->
    <div class="catalog-filter-bar">
      <nav class="luxury-breadcrumb">
        <a href="/">Accueil</a>
        <span class="separator">/</span>
        <span class="current">Meubles</span>
      </nav>

      <div class="filter-controls">
        <button class="filter-btn active" data-filter="all">Tous</button>
        {sections.map((section) => (
          <button class="filter-btn" data-filter={section.id}>
            {section.label.replace("Meubles ", "")}
          </button>
        ))}
      </div>
    </div>

    <!-- CONTENU DES COLLECTIONS -->
    <div class="luxury-content-wrapper">
      
      <!-- 1. SECTION ALL / MIXÉE (Affichée par défaut) -->
      <section id="all-gallery" class="luxury-section data-catalog-section" style="display: block; opacity: 1;">
        <!--
        <div class="luxury-section-header">
          <div class="header-title-block">          
            <h2 class="luxury-section-title">Collection <span>complète</span></h2>           
          </div>
        </div>
        --> 
        <div class="luxury-monumental-grid">
          {toutesLesDressingMixees.map((item) => (
            <div class="luxury-card-container">
              <Card 
                type="meuble"
                id={item.id}
                nom={item.nom} 
                prix={item.prix_initial} 
                promo={item.reduction} 
                image={item.catalogue_images[0]} 
              />
            </div>
          ))}
        </div>
      </section>

      <!-- 2. SECTIONS PAR CONFIGURATION (Masquées par défaut au profit du mix global) -->
      {sections.map((section) => {
        const produitsParForme = meublesData.filter(item => item.forme === section.valeur);

        return produitsParForme.length > 0 && (
          <section id={section.id} class="luxury-section data-catalog-section" style="display: none; opacity: 0;">
            
            <div class="luxury-section-header">
              <div class="header-title-block">
              <!--  
                <h2 class="luxury-section-title">
                  {section.label.split(' ')[0]} {section.label.split(' ').slice(1).join(' ')}
                </h2>
              --> 
              </div>
              
            </div>

            <div class="luxury-monumental-grid">
              {produitsParForme.map((item) => (
                <div class="luxury-card-container">
                  <Card 
                    type="meuble"
                    id={item.id}
                    nom={item.nom} 
                    prix={item.prix_initial} 
                    promo={item.reduction} 
                    image={item.catalogue_images[0]} 
                  />
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <div class="anatomies">
      <div class="anatomie-text">
        <h1 class="titre-anatomie">Vous ne savez pas quelle forme choisir ?</h1>
        <p class="text-titre-anatomie">Consultez notre guide interactif des formes de cuisines.</p>
      </div>
      <a href={`/cuisines-infos`} class="btn-text-flip"> 
        <span class="text-default">Explorer l'anatomie</span>
        <span class="text-hover">Explorer l'anatomie</span>                
      </a>    
    </div>

  </main>
</Layout>

