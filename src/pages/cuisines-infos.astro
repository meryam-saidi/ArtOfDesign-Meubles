---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import cuisinesData from '../data/cuisines.json';
import '../styles/details.css';


// On définit les sections que l'on veut afficher
const sectionsInfos = [
  {
    id: "forme-i-infos",
    title: "La Cuisine en Forme de I (Linéaire)",
    image: "/images/autres/cuisine-i-info.png",
    description: "Idéale pour les espaces étroits ou les studios, la cuisine en I concentre tous les éléments sur un seul pan de mur. C'est la solution gain de place par excellence qui offre un design épuré et minimaliste.",
    avantages: ["Optimisation maximale de l'espace", "Coût d'installation réduit", "Idéal pour les cuisines ouvertes"],
    labelBouton: "en Forme de I"
  },
  {
    id: "forme-l-infos",
    title: "La Cuisine en Forme de L",
    image: "/images/autres/cuisine-l-info.png",
    description: "C'est la disposition la plus populaire. Elle occupe deux murs adjacents, créant un angle de travail naturel. Elle permet d'intégrer facilement une table à manger au centre de la pièce.",
    avantages: ["Respect du triangle d'activité", "S'adapte à toutes les tailles de pièces", "Facilite la circulation"],
    labelBouton: "en Forme de L"
  },
  {
    id: "forme-u-infos",
    title: "La Cuisine en Forme de U",
    image: "/images/autres/cuisine-u-info.png",
    description: "Utilisant trois murs, la cuisine en U offre une surface de plan de travail généreuse et de nombreuses solutions de rangement. C'est le choix des passionnés de gastronomie qui veulent tout à portée de main.",
    avantages: ["Volume de rangement exceptionnel", "Grande surface de préparation", "Espace de travail sécurisé"],
    labelBouton: "en Forme de U"
  },
  {
    id: "ilot-infos",
    title: "La Cuisine avec Îlot Central",
    image: "/images/autres/cuisine-u-info.png",
    description: "Véritable cœur de la maison, l'îlot central apporte convivialité et modernité. Il sert à la fois de zone de préparation, de coin repas et d'espace de rangement supplémentaire.",
    avantages: ["Design haut de gamme", "Convivialité (cuisine spectacle)", "Polyvalence d'utilisation"],
    labelBouton: "avec Îlot"
  }
];
---

<Layout title="Conseils d'Aménagement | AD Cuisine" theme="dark" pageBg="light">
  <main class="bg-white">
    <!--
    <section class="cuisine-intro">
      <div class="cuisine-intro-content">
        <h1>
          Bien choisir la forme de sa cuisine
        </h1>
        <p>
          L'implantation est la clé d'une cuisine fonctionnelle. Découvrez nos conseils
          pour choisir la configuration qui sublimera votre intérieur selon vos besoins.
        </p>
      </div>
    </section>
     -->
    <div class="catalog-filter-bar">
      <nav class="breadcrumb">
        <a href="/">Accueil</a>
        <span class="separator">/</span>
        <span class="active-crumb-text">Conseils d'Aménagement</span>
      </nav>
    </div>

    <div class="items-container">
      {sectionsInfos.map((item, index) => (
        <section id={item.id} class={`py-14 scroll-mt-24 ${index % 2 !== 0 ? 'bg-gray-50' : 'bg-white'}`}>
          <div class="configurations">
            <div class={`flex flex-col md:flex-row items-center gap-12 ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>
              
              <div class="w-full md:w-1/2 relative group">
                <div class="absolute -inset-4 border border-[var(--color-gold)]/20 translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-500"></div>
                <img 
                  src={item.image} 
                  alt={item.title} 
                  class="relative w-full object-cover shadow-2xl rounded-sm"
                />
              </div>

              <div class="w-full md:w-1/2">
                <span class="brand-badge">Configuration</span>
                <h2 class="product-title">{item.title}</h2>
                <p class="text-gray-600 mb-8 leading-relaxed font-light text-lg">
                  {item.description}
                </p>
                
                <div class="space-y-4">
                  <h4 class="nuancier-title">Points forts :</h4>
                  <ul class="space-y-3">
                    {item.avantages.map((adv) => (
                      <li class="flex items-center gap-3 text-sm text-gray-500">
                        <span class="w-1.5 h-1.5 bg-[var(--color-gold)] rounded-full"></span>
                        {adv}
                      </li>
                    ))}
                  </ul>
                </div>
                <a href={`/cuisines#${item.id.replace('-infos', '')}`} class="btn-text-flip"> 
                  <span class="text-default">Voir nos modèles {item.labelBouton} <span class="arrow">→</span></span>
                  <span class="text-hover">Voir nos modèles {item.labelBouton} <span class="arrow">→</span></span>                
                </a> 
                {/* 
                <a href={`/cuisines#${item.id.replace('-infos', '')}`} class="inline-block mt-10 px-8 py-3 bg-black text-white text-[10px] uppercase font-bold tracking-[0.2em] hover:bg-[var(--color-gold)] transition-colors">
                Voir nos modèles {item.labelBouton}
                </a>
                */}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="py-24 bg-white text-center border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6">
        <h3 class="font-serif text-3xl mb-6 italic text-[var(--gold)]">Vous hésitez encore ?</h3>
        <p class="text-gray-500 font-light">Nos experts concepteurs réalisent pour vous un plan 3D gratuit pour visualiser votre future cuisine.</p>
        <a href={`/contact`} class="btn-text-flip"> 
          <span class="text-default">Demander une étude gratuite <span class="arrow">→</span></span>
          <span class="text-hover">Demander une étude gratuite <span class="arrow">→</span></span>                
        </a>  
        {/*       
        <button class="border-2 border-black px-10 py-4 text-xs font-bold uppercase tracking-[0.2em] hover:bg-black hover:text-white transition-all">
          Demander une étude gratuite
        </button>
        */}  
      </div>
    </section>
  </main>
</Layout>

<style> 
  .cuisine-intro {
    background-color: #f9fafb; /* bg-gray-50 */
    padding-top: 10rem;         /* pt-20 */
    padding-bottom: 5rem;      /* py-20 */
    border-bottom: 1px solid #f3f4f6; /* border-gray-100 */
  }

  .cuisine-intro-content {
    margin: 0 auto;
    padding: 0 1.5rem; /* px-6 */
    text-align: center;
  }

  .cuisine-intro h1 {
   font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    display: block;
    margin-bottom: 1rem;
  }

  .cuisine-intro p {
    margin: 0;
    color: #6b7280; /* text-gray-500 */
    line-height: 1.625; /* leading-relaxed */
    font-weight: 300; /* font-light */
  }

  /* md:text-5xl */
  @media (min-width: 768px) {
    .cuisine-intro h1 {
      font-size: 3rem;
    }
  }

  .configurations{
    padding: 0 4rem;
  }
  
  .catalog-filter-bar {
    padding: 12rem 2rem 0rem 2em;
    background-color: white;
    margin: 0rem 2rem;
  }
  .breadcrumb{
    margin-bottom: 0rem;
  }
  .luxury-breadcrumb a {
    color: black;
  }
  .btn-text-flip{
    margin-top: 4rem;
  }
  .text-default{
    color: black;
  }
</style>