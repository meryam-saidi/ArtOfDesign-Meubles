---
// src/pages/admin/cuisines.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import cuisinesData from '../../data/cuisines.json';

interface DimensionsCaisson {
  hauteur: string;
  profondeur: string;
}

interface CuisineItem {
  id: string;
  nom: string;
  forme: string;
  prix_initial: number;
  reduction?: number;
  catalogue_images?: string[];
  dimensions: {
    caisson_bas: DimensionsCaisson;
    caisson_haut?: DimensionsCaisson;
  };
  caracteristiques_techniques?: {
    composition_type?: string[];
    finition_produit?: {
      caisson?: string;
      facade?: string;
    };
  };
  nb?: string;
}

const initialCuisines = (cuisinesData as CuisineItem[]) ?? [];

const computeFinalPrice = (item: CuisineItem) => {
  if (!item.reduction || item.reduction <= 0) return item.prix_initial;
  return Math.round(item.prix_initial * (1 - item.reduction / 100));
};
---

<AdminLayout
  title="Gestion des Cuisines | Art Of Design"
  pageTitle="Cuisines sur mesure"
  activeNav="cuisines"
>
  <div slot="actions">
    <button type="button" id="btn-new-cuisine" class="admin-btn-primary">
      + Nouvelle cuisine
    </button>
  </div>

  <!-- KPIs RAPIDES -->
  <section class="admin-grid-stats" aria-label="Indicateurs cuisines">
    <article class="admin-card">
      <h2 class="admin-card-title">Modèles référencés</h2>
      <p class="admin-stat-value" id="stat-total-cuisines">{initialCuisines.length}</p>
      <p class="admin-stat-meta">Catalogue Cuisines</p>
    </article>

    <article class="admin-card">
      <h2 class="admin-card-title">En promotion</h2>
      <p class="admin-stat-value" id="stat-promo-cuisines">
        {initialCuisines.filter((c) => (c.reduction ?? 0) > 0).length}
      </p>
      <p class="admin-stat-meta">Réduction active</p>
    </article>

    <article class="admin-card">
      <h2 class="admin-card-title">Modèles Îlot</h2>
      <p class="admin-stat-value" id="stat-ilot-cuisines">
        {initialCuisines.filter((c) => c.forme.toLowerCase() === 'ilot').length}
      </p>
      <p class="admin-stat-meta">Sans caisson haut</p>
    </article>
  </section>

  <!-- FORMULAIRE D'ÉDITION / CRÉATION -->
  <section
    id="cuisine-editor-card"
    class="admin-card"
    style="display: none; margin-bottom: 2rem; border-color: var(--admin-border-gold);"
    aria-labelledby="editor-heading"
  >
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem;">
      <div>
        <p class="admin-eyebrow" style="margin-bottom: 0.15rem;">Édition du catalogue</p>
        <h2 id="editor-heading" style="margin: 0; font-size: 1.2rem;">Modifier une cuisine</h2>
      </div>
      <button type="button" id="btn-cancel-edit" class="admin-ghost-btn" style="width: auto;">
        Fermer
      </button>
    </div>

    <form id="cuisine-form" class="admin-form-grid">
      <input type="hidden" id="cuisine-mode" value="edit" />

      <div class="admin-field">
        <label for="cuisine-id" class="admin-label">Identifiant (slug / ID)</label>
        <input
          type="text"
          id="cuisine-id"
          name="id"
          class="admin-input"
          placeholder="ex: cl400x200m2"
          required
        />
      </div>

      <div class="admin-field">
        <label for="cuisine-nom" class="admin-label">Nom du modèle</label>
        <input
          type="text"
          id="cuisine-nom"
          name="nom"
          class="admin-input"
          placeholder="ex: Céleste Chêne & Noir"
          required
        />
      </div>

      <div class="admin-field">
        <label for="cuisine-forme" class="admin-label">Forme d'implantation</label>
        <select id="cuisine-forme" name="forme" class="admin-select">
          <option value="Linéaire">Linéaire</option>
          <option value="En L">En L</option>
          <option value="En U">En U</option>
          <option value="Ilot">Ilot</option>
        </select>
      </div>

      <div class="admin-field" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
        <div class="admin-field">
          <label for="cuisine-prix" class="admin-label">Prix initial (TTC)</label>
          <input
            type="number"
            id="cuisine-prix"
            name="prix_initial"
            class="admin-input"
            min="0"
            step="1"
            required
          />
        </div>
        <div class="admin-field">
          <label for="cuisine-reduction" class="admin-label">Réduction (%)</label>
          <input
            type="number"
            id="cuisine-reduction"
            name="reduction"
            class="admin-input"
            min="0"
            max="90"
            step="1"
            value="0"
          />
        </div>
      </div>

      <!-- DIMENSIONS CAISSON BAS -->
      <div class="admin-field">
        <label for="caisson-bas-hauteur" class="admin-label">Caisson bas — Hauteur</label>
        <input
          type="text"
          id="caisson-bas-hauteur"
          class="admin-input"
          placeholder="ex: 78 cm"
        />
      </div>

      <div class="admin-field">
        <label for="caisson-bas-profondeur" class="admin-label">Caisson bas — Profondeur</label>
        <input
          type="text"
          id="caisson-bas-profondeur"
          class="admin-input"
          placeholder="ex: 60 cm"
        />
      </div>

      <!-- DIMENSIONS CAISSON HAUT (MASQUÉ SI FORME === 'Ilot') -->
      <div id="caisson-haut-fields" class="admin-field admin-field--full" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.15rem;">
        <div class="admin-field">
          <label for="caisson-haut-hauteur" class="admin-label">Caisson haut — Hauteur</label>
          <input
            type="text"
            id="caisson-haut-hauteur"
            class="admin-input"
            placeholder="ex: 72 cm"
          />
        </div>

        <div class="admin-field">
          <label for="caisson-haut-profondeur" class="admin-label">Caisson haut — Profondeur</label>
          <input
            type="text"
            id="caisson-haut-profondeur"
            class="admin-input"
            placeholder="ex: 35 cm"
          />
        </div>
      </div>

      <div class="admin-field">
        <label for="finition-caisson" class="admin-label">Finition caisson</label>
        <input
          type="text"
          id="finition-caisson"
          class="admin-input"
          placeholder="ex: Panneau mélaminé hydrofuge haute densité"
        />
      </div>

      <div class="admin-field">
        <label for="finition-facade" class="admin-label">Finition façade</label>
        <input
          type="text"
          id="finition-facade"
          class="admin-input"
          placeholder="ex: Laque mate anti-traces / Chêne naturel"
        />
      </div>

      <div class="admin-field admin-field--full">
        <label for="cuisine-nb" class="admin-label">Note technique (NB)</label>
        <textarea
          id="cuisine-nb"
          rows="2"
          class="admin-textarea"
          placeholder="Précisions sur les dimensions, électroménager ou options..."
        ></textarea>
      </div>

      <div class="admin-field admin-field--full" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
        <button type="button" id="btn-reset-storage" class="admin-ghost-btn" style="width: auto;">
          Réinitialiser depuis JSON
        </button>
        <button type="submit" class="admin-btn-primary">
          Enregistrer la cuisine
        </button>
      </div>
    </form>
  </section>

  <!-- LISTE DES CUISINES -->
  <section aria-label="Liste des cuisines">
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Modèle</th>
            <th>ID</th>
            <th>Forme</th>
            <th>Dimensions</th>
            <th>Prix TTC</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="cuisines-tbody">
          {initialCuisines.map((item) => {
            const finalPrice = computeFinalPrice(item);
            return (
              <tr data-id={item.id}>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    {item.catalogue_images?.[0] && (
                      <img
                        src={item.catalogue_images[0]}
                        alt={item.nom}
                        style="width: 48px; height: 36px; object-fit: cover; border-radius: 4px; border: 1px solid var(--admin-border);"
                      />
                    )}
                    <strong>{item.nom}</strong>
                  </div>
                </td>
                <td style="color: var(--admin-text-muted); font-family: monospace; font-size: 0.8rem;">
                  {item.id}
                </td>
                <td>
                  <span class="admin-badge" style="margin-top: 0;">{item.forme}</span>
                </td>
                <td style="color: var(--admin-text-muted); font-size: 0.82rem;">
                  Bas : {item.dimensions?.caisson_bas?.hauteur ?? '—'} × {item.dimensions?.caisson_bas?.profondeur ?? '—'}
                  {item.forme !== 'Ilot' && item.dimensions?.caisson_haut && (
                    <>
                      <br />
                      Haut : {item.dimensions.caisson_haut.hauteur} × {item.dimensions.caisson_haut.profondeur}
                    </>
                  )}
                </td>
                <td>
                  {item.reduction && item.reduction > 0 ? (
                    <div>
                      <span style="font-weight: 600; color: var(--admin-gold);">{finalPrice}</span>
                      <span style="margin-left: 0.4rem; font-size: 0.75rem; color: var(--admin-text-muted); text-decoration: line-through;">
                        {item.prix_initial}
                      </span>
                      <span style="margin-left: 0.35rem; font-size: 0.75rem; color: var(--admin-success);">
                        -{item.reduction}%
                      </span>
                    </div>
                  ) : (
                    <span style="font-weight: 600;">{item.prix_initial}</span>
                  )}
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button
                      type="button"
                      class="admin-ghost-btn btn-edit-cuisine"
                      data-id={item.id}
                      style="width: auto; padding: 0.4rem 0.75rem; font-size: 0.8rem;"
                    >
                      Éditer
                    </button>
                    <a
                      href={`/cuisine/${item.id.toLowerCase()}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="admin-ghost-btn"
                      style="width: auto; padding: 0.4rem 0.75rem; font-size: 0.8rem;"
                    >
                      Voir ↗
                    </a>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script define:vars={{ initialCuisines }}>
  const STORAGE_KEY = 'aod_admin_cuisines_v1';

  const loadState = () => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved ? JSON.parse(saved) : structuredClone(initialCuisines);
    } catch {
      return structuredClone(initialCuisines);
    }
  };

  let cuisines = loadState();

  const tbody = document.getElementById('cuisines-tbody');
  const editorCard = document.getElementById('cuisine-editor-card');
  const editorHeading = document.getElementById('editor-heading');
  const form = document.getElementById('cuisine-form');
  const modeInput = document.getElementById('cuisine-mode');
  const idInput = document.getElementById('cuisine-id');
  const nomInput = document.getElementById('cuisine-nom');
  const formeSelect = document.getElementById('cuisine-forme');
  const prixInput = document.getElementById('cuisine-prix');
  const reductionInput = document.getElementById('cuisine-reduction');
  const basHauteurInput = document.getElementById('caisson-bas-hauteur');
  const basProfondeurInput = document.getElementById('caisson-bas-profondeur');
  const hautFieldsWrap = document.getElementById('caisson-haut-fields');
  const hautHauteurInput = document.getElementById('caisson-haut-hauteur');
  const hautProfondeurInput = document.getElementById('caisson-haut-profondeur');
  const finitionCaissonInput = document.getElementById('finition-caisson');
  const finitionFacadeInput = document.getElementById('finition-facade');
  const nbInput = document.getElementById('cuisine-nb');

  const toggleHautFields = () => {
    if (!hautFieldsWrap || !formeSelect) return;
    hautFieldsWrap.style.display = formeSelect.value === 'Ilot' ? 'none' : 'grid';
  };

  const updateStats = () => {
    const totalEl = document.getElementById('stat-total-cuisines');
    const promoEl = document.getElementById('stat-promo-cuisines');
    const ilotEl = document.getElementById('stat-ilot-cuisines');

    if (totalEl) totalEl.textContent = String(cuisines.length);
    if (promoEl) promoEl.textContent = String(cuisines.filter((c) => Number(c.reduction || 0) > 0).length);
    if (ilotEl) ilotEl.textContent = String(cuisines.filter((c) => String(c.forme).toLowerCase() === 'ilot').length);
  };

  const getFinalPrice = (item) => {
    const red = Number(item.reduction || 0);
    const base = Number(item.prix_initial || 0);
    return red > 0 ? Math.round(base * (1 - red / 100)) : base;
  };

  const renderTable = () => {
    if (!tbody) return;
    tbody.innerHTML = cuisines
      .map((item) => {
        const finalPrice = getFinalPrice(item);
        const hasPromo = Number(item.reduction || 0) > 0;
        const imgHtml = item.catalogue_images?.[0]
          ? `<img src="${item.catalogue_images[0]}" alt="${item.nom}" style="width: 48px; height: 36px; object-fit: cover; border-radius: 4px; border: 1px solid var(--admin-border);" />`
          : '';

        const hautDimHtml =
          item.forme !== 'Ilot' && item.dimensions?.caisson_haut
            ? `<br />Haut : ${item.dimensions.caisson_haut.hauteur} × ${item.dimensions.caisson_haut.profondeur}`
            : '';

        const priceHtml = hasPromo
          ? `<div>
               <span style="font-weight: 600; color: var(--admin-gold);">${finalPrice}</span>
               <span style="margin-left: 0.4rem; font-size: 0.75rem; color: var(--admin-text-muted); text-decoration: line-through;">${item.prix_initial}</span>
               <span style="margin-left: 0.35rem; font-size: 0.75rem; color: var(--admin-success);">-${item.reduction}%</span>
             </div>`
          : `<span style="font-weight: 600;">${item.prix_initial}</span>`;

        return `
          <tr data-id="${item.id}">
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                ${imgHtml}
                <strong>${item.nom}</strong>
              </div>
            </td>
            <td style="color: var(--admin-text-muted); font-family: monospace; font-size: 0.8rem;">${item.id}</td>
            <td><span class="admin-badge" style="margin-top: 0;">${item.forme}</span></td>
            <td style="color: var(--admin-text-muted); font-size: 0.82rem;">
              Bas : ${item.dimensions?.caisson_bas?.hauteur ?? '—'} × ${item.dimensions?.caisson_bas?.profondeur ?? '—'}${hautDimHtml}
            </td>
            <td>${priceHtml}</td>
            <td>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button type="button" class="admin-ghost-btn btn-edit-cuisine" data-id="${item.id}" style="width: auto; padding: 0.4rem 0.75rem; font-size: 0.8rem;">
                  Éditer
                </button>
                <a href="/cuisine/${String(item.id).toLowerCase()}" target="_blank" rel="noopener noreferrer" class="admin-ghost-btn" style="width: auto; padding: 0.4rem 0.75rem; font-size: 0.8rem;">
                  Voir ↗
                </a>
              </div>
            </td>
          </tr>
        `;
      })
      .join('');

    updateStats();
  };

  const openEditor = (item = null) => {
    if (!editorCard || !form) return;
    editorCard.style.display = 'block';

    if (item) {
      if (editorHeading) editorHeading.textContent = `Modifier : ${item.nom}`;
      if (modeInput) modeInput.value = 'edit';
      if (idInput) {
        idInput.value = item.id;
        idInput.readOnly = true;
      }
      if (nomInput) nomInput.value = item.nom || '';
      if (formeSelect) formeSelect.value = item.forme || 'Linéaire';
      if (prixInput) prixInput.value = String(item.prix_initial ?? 0);
      if (reductionInput) reductionInput.value = String(item.reduction ?? 0);
      if (basHauteurInput) basHauteurInput.value = item.dimensions?.caisson_bas?.hauteur || '';
      if (basProfondeurInput) basProfondeurInput.value = item.dimensions?.caisson_bas?.profondeur || '';
      if (hautHauteurInput) hautHauteurInput.value = item.dimensions?.caisson_haut?.hauteur || '';
      if (hautProfondeurInput) hautProfondeurInput.value = item.dimensions?.caisson_haut?.profondeur || '';
      if (finitionCaissonInput) finitionCaissonInput.value = item.caracteristiques_techniques?.finition_produit?.caisson || '';
      if (finitionFacadeInput) finitionFacadeInput.value = item.caracteristiques_techniques?.finition_produit?.facade || '';
      if (nbInput) nbInput.value = item.nb || '';
    } else {
      form.reset();
      if (editorHeading) editorHeading.textContent = 'Ajouter une cuisine';
      if (modeInput) modeInput.value = 'create';
      if (idInput) idInput.readOnly = false;
      if (reductionInput) reductionInput.value = '0';
    }

    toggleHautFields();
    editorCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  document.getElementById('btn-new-cuisine')?.addEventListener('click', () => openEditor(null));
  document.getElementById('btn-cancel-edit')?.addEventListener('click', () => {
    if (editorCard) editorCard.style.display = 'none';
  });

  formeSelect?.addEventListener('change', toggleHautFields);

  tbody?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('.btn-edit-cuisine') : null;
    if (!target) return;
    const id = target.getAttribute('data-id');
    const found = cuisines.find((c) => String(c.id) === String(id));
    if (found) openEditor(found);
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const rawId = (idInput?.value || '').trim().toLowerCase();
    const forme = formeSelect?.value || 'Linéaire';

    const updatedItem = {
      id: rawId,
      nom: (nomInput?.value || '').trim(),
      forme,
      prix_initial: Number(prixInput?.value || 0),
      reduction: Number(reductionInput?.value || 0),
      dimensions: {
        caisson_bas: {
          hauteur: (basHauteurInput?.value || '').trim(),
          profondeur: (basProfondeurInput?.value || '').trim(),
        },
        ...(forme !== 'Ilot'
          ? {
              caisson_haut: {
                hauteur: (hautHauteurInput?.value || '').trim(),
                profondeur: (hautProfondeurInput?.value || '').trim(),
              },
            }
          : {}),
      },
      caracteristiques_techniques: {
        finition_produit: {
          caisson: (finitionCaissonInput?.value || '').trim(),
          facade: (finitionFacadeInput?.value || '').trim(),
        },
      },
      nb: (nbInput?.value || '').trim(),
    };

    const mode = modeInput?.value || 'edit';
    if (mode === 'create') {
      cuisines = [updatedItem, ...cuisines.filter((c) => String(c.id).toLowerCase() !== rawId)];
    } else {
      cuisines = cuisines.map((c) =>
        String(c.id).toLowerCase() === rawId
          ? {
              ...c,
              ...updatedItem,
              catalogue_images: c.catalogue_images,
              caracteristiques_techniques: {
                ...c.caracteristiques_techniques,
                ...updatedItem.caracteristiques_techniques,
              },
            }
          : c
      );
    }

    localStorage.setItem(STORAGE_KEY, JSON.stringify(cuisines));
    renderTable();
    if (editorCard) editorCard.style.display = 'none';
  });

  document.getElementById('btn-reset-storage')?.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    cuisines = structuredClone(initialCuisines);
    renderTable();
  });

  renderTable();
</script>