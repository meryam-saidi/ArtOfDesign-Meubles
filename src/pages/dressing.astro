---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import dressingData from '../data/dressing.json';

// Structure des filtres principaux (Formes)
const formes = [
  { id: "forme-i", label: "Dressing Forme I", valeur: "I" },
  { id: "forme-l", label: "Dressing Forme L", valeur: "L" }
];

// Séparation des données Forme I par type d'ouverture
const formeIFr = dressingData.filter(item => item.forme === "I" && (item.type_ouverture === "Fr"));
const formeICoulissant = dressingData.filter(item => item.forme === "I" && (item.type_ouverture === "C"));

// Autres formes (Forme L)
const formeL = dressingData.filter(item => item.forme === "L");

// Collection mixée pour le filtre "Tous"
const toutesLesDressingMixees = [...dressingData].sort(() => 0.5 - Math.random());
---

<Layout title="Nos Modèles de Dressings | Art Of Design">
  <main class="luxury-catalog">

    <!-- LUXURY HERO -->
    <section class="luxury-hero">
      <div class="luxury-hero-bg">
        <img 
          src="/images/autres/1.jpg" 
          alt="Art Of Design Haute Couture" 
          class="luxury-hero-img"
        />
        <div class="luxury-hero-overlay"></div>
      </div>

      <div class="luxury-hero-content">
        <h1 class="luxury-main-title">
          Dressings sur mesure
        </h1>
        <p class="luxury-text">Rangez avec élégance. Chaque dressing est pensé pour maximiser votre espace tout en sublimant votre chambre.</p>
        <p class="luxury-subtitle">Collection Dressings</p>
      </div>
    </section>

    <!-- BARRE DE NAVIGATION ET FILTRES -->
    <div class="catalog-filter-bar">
      <nav class="luxury-breadcrumb">
        <a href="/">Accueil</a>
        <span class="separator">/</span>
        <span class="current">Dressings</span>
      </nav>

      <div class="filter-controls">
        <button class="filter-btn active" data-filter="all">Tous</button>
        {formes.map((forme) => (
          <button class="filter-btn" data-filter={forme.id}>
            {forme.label}
          </button>
        ))}
      </div>
    </div>

    <!-- CONTENU DU CATALOGUE -->
    <div class="luxury-content-wrapper">

      {/* 1. VUE GLOVALE "TOUS" (Affichée par défaut) */}
      <section id="all-gallery" class="luxury-section data-catalog-section" style="display: block; opacity: 1;">
        <div class="luxury-monumental-grid">
          {toutesLesDressingMixees.map((item) => (
            <div class="luxury-card-container">
              <Card 
                type="dressing"
                id={item.id}
                nom={item.nom} 
                prix={item.prix_initial} 
                promo={item.reduction} 
                image={item.catalogue_images?.[0]} 
              />
            </div>
          ))}
        </div>
      </section>

      {/* 2. VUE FORME I (AVEC SOUS-TITRES POUR FR ET COULISSANT) */}
      <section id="forme-i" class="luxury-section data-catalog-section" style="display: none; opacity: 0;">
        
        {/* SOUS-SECTION : À LA FRANÇAISE */}
        {formeIFr.length > 0 && (
          <div id="francaise" class="sub-category-block">
            <h2 class="sub-category-title">Dressings À La Française</h2>
            <div class="luxury-monumental-grid">
              {formeIFr.map((item) => (
                <div class="luxury-card-container">
                  <Card 
                    type="dressing"
                    id={item.id}
                    nom={item.nom} 
                    prix={item.prix_initial} 
                    promo={item.reduction} 
                    image={item.catalogue_images?.[0]} 
                  />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* SOUS-SECTION : COULISSANT */}
        {formeICoulissant.length > 0 && (
          <div id="coulissant" class="sub-category-block">
            <h2 class="sub-category-title">Dressings Coulissants</h2>
            <div class="luxury-monumental-grid">
              {formeICoulissant.map((item) => (
                <div class="luxury-card-container">
                  <Card 
                    type="dressing"
                    id={item.id}
                    nom={item.nom} 
                    prix={item.prix_initial} 
                    promo={item.reduction} 
                    image={item.catalogue_images?.[0]} 
                  />
                </div>
              ))}
            </div>
          </div>
        )}

      </section>

      {/* 3. VUE FORME L */}
      <section id="forme-l" class="luxury-section data-catalog-section" style="display: none; opacity: 0;">
        <div class="luxury-monumental-grid">
          {formeL.map((item) => (
            <div class="luxury-card-container">
              <Card 
                type="dressing"
                id={item.id}
                nom={item.nom} 
                prix={item.prix_initial} 
                promo={item.reduction} 
                image={item.catalogue_images?.[0]} 
              />
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- GUIDE INTERACTIF -->
    <div class="anatomies">
      <div class="anatomie-text">
        <h1 class="titre-anatomie">Vous ne savez pas quelle forme choisir ?</h1>
        <p class="text-titre-anatomie">Consultez notre guide interactif des dressings.</p>
      </div>
      <a href={`/cuisines-infos`} class="btn-text-flip"> 
        <span class="text-default">Lire Le Guide <span class="arrow">→</span></span>
        <span class="text-hover">Lire Le Guide <span class="arrow">→</span></span>                
      </a>     
    </div>

  </main>
</Layout>

<style>
  /* ── STYLE DES SOUS-TITRES DANS FORME I ── */
  .sub-category-block {
    margin-bottom: 7.5rem;
  }

  .sub-category-block:last-child {
    margin-bottom: 0;
  }

  .sub-category-title {
    font-size: 1rem;
    font-weight: 300;
    color: white;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    /* border-bottom: 1px solid rgba(201, 168, 76, 0.2); */
    text-transform: uppercase;
  }
</style>
