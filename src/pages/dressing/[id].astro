---
// src/pages/dressing/[id].astro
import Layout from '../../layouts/Layout.astro';
import dressingsData from '../../data/dressing.json';
import '../../styles/details.css';

export async function getStaticPaths() {
  return dressingsData.map((dressing) => {
    return {
      params: { id: dressing.id.toString().toLowerCase() },
      props: { dressing },
    };
  });
}

const { dressing } = Astro.props;

const prixFinal = dressing.reduction 
  ? dressing.prix_initial * (1 - dressing.reduction / 100) 
  : dressing.prix_initial;

// Séparation équitable de la composition type en deux colonnes pour affichage horizontal
const milieuComposition = Math.ceil(dressing.caracteristiques_techniques.composition_type.length / 2);
const compoCol1 = dressing.caracteristiques_techniques.composition_type.slice(0, milieuComposition);
const compoCol2 = dressing.caracteristiques_techniques.composition_type.slice(milieuComposition);
---

<Layout title="Nos dressings | Art Of Design" theme="dark" pageBg="light">
  <main class="details-page">
    <!--
    <section class="details-hero">
      <div class="details-hero-viewport">
        <img 
          src={dressing.catalogue_images?.[0]} 
          alt={`Art Of Design - Haute dressing ${dressing.nom}`} 
          class="details-hero-media"
        />
        <div class="details-hero-overlay"></div>
      </div>
      
      <div class="hero-details-scroll">
       <span>{dressing.nom}</span>
      <div class="scroll-details-line"></div>
    </div>
    </section>
    -->
    <div class="product-container">
      <nav class="breadcrumb">
          <a href="/">Accueil</a>
          <span>/</span>
          <a href="/dressing">dressings</a>
          <span>/</span>
          <span class="active-crumb-text">{dressing.nom}</span>
      </nav>

      <div class="main-product-grid">     
        <div class="visuals-zone">

          <div class="main-visual-wrapper">
            <img 
              id="main-visual"
              src={dressing.catalogue_images?.[0]} 
              alt={dressing.nom} 
            />
            <div class="visual-overlay"></div>
          </div>

          <div class="slider-wrapper-relative">
            <button id="slide-prev" class="slider-arrow prev-arrow" aria-label="Précédent">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
            </button>

            <div class="slider-container" id="slider-mask">
              <div class="thumbnails-slider-rail" id="thumb-rail">
                {dressing.catalogue_images?.map((img, index) => (
                  <button class={`thumb-btn ${index === 0 ? 'active-thumb' : ''}`} data-full={img}>
                    <img src={img} alt={`Aperçu ${index + 1}`} />
                  </button>
                ))}
              </div>
            </div>

            <button id="slide-next" class="slider-arrow next-arrow" aria-label="Suivant">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>

        </div>

        <div class="details-zone">
          <div class="header-details">
            <span class="brand-badge">Exclusivité AD dressing</span>
            <h1 class="product-title">{dressing.nom}</h1>
            
            <div class="price-wrapper">
              {dressing.reduction ? (
                <div class="price-flex">
                  <p class="price-old">{dressing.prix_initial} TTC</p>
                  <p class="price-current">{prixFinal} TTC</p>                
                  <span class="discount-tag">-{dressing.reduction}%</span>
                </div>
              ) : (
                <p class="price-current">{dressing.prix_initial} TTC</p>
              )}
            </div>
          </div>
          
          <div class="specs-block">
            <p><strong class="spec-paragraph">Dimensions caisson bas </strong> <br /> hauteur {dressing.dimensions.hauteur} <br /> profondeur {dressing.dimensions.profondeur}</p>
            <p><strong class="spec-paragraph">Dimensions caisson haut </strong> <br /> hauteur {dressing.dimensions.hauteur} <br /> profondeur {dressing.dimensions.profondeur}</p>
          </div>

          <div class="nuancier-block">
            <div class="nuancier-header">
              <h3 class="nuancier-title">Nuancier disponible</h3>
              <span id="color-label" class="color-current-name"></span>
            </div>

            <div class="swatches-row">
              {dressing.couleurs?.map((v) => (
                <button 
                  class={`color-swatch ${v.nom === "Chêne naturel" ? "active-swatch" : ""}`}
                  style={`background-image: url(${v.image_presentation}); background-size: cover; background-position: center;`}
                  data-value={v.image_presentation}
                  title={v.nom}
                >
                </button>
              ))}
            </div>

            <div class="preview-card-wrapper">
              <div id="texture-preview-card" class="preview-card-el"></div>
            </div>
          </div>

          <div class="cta-wrapper">
            <a href="/#contact" class="btn-text-flip"> 
              <span class="text-default">Réserver mon étude gratuite</span>
              <span class="text-hover">Réserver mon étude gratuite</span>
            </a> 
          </div>
        </div>
      </div>

      <div class="technical-section">
        <h3 class="technical-main-title">Caractéristiques techniques des éléments</h3>
        
        <div class="tech-dropdowns">
          
          {/* DROPDOWN : COMPOSITION TYPE */}
          <div class="tech-item dropdown active" id="dropdown-composition">
            <button class="tech-header dropdown-toggle">
              <span class="tech-item-number reveal"></span> <!--I -->
              <h4>Composition type</h4>
              <div class="dropdown-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </button>
            <div class="tech-content dropdown-pane">
              <div class="tech-content-inner">
                <div class="tech-composition-cols">
                  <ul class="tech-list">
                    {compoCol1.map((item) => (
                      <li><span>•</span> {item}</li>
                    ))}
                  </ul>
                  <ul class="tech-list">
                    {compoCol2.map((item) => (
                      <li><span>•</span> {item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          {/* DROPDOWN : FINITION PRODUIT */}
          <div class="tech-item dropdown" id="dropdown-finition">
            <button class="tech-header dropdown-toggle">
              <span class="tech-item-number"></span>
              <h4>Finition produit</h4>
              <div class="dropdown-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </button>
            <div class="tech-content dropdown-pane">
              <div class="tech-content-inner">
                <div class="tech-finition-details">
                  <div class="tech-finition-item">
                    <strong class="sub-label">Caisson</strong>
                    <p class="tech-paragraph">{dressing.caracteristiques_techniques.finition_produit.caisson}</p>
                  </div>
                  <div class="tech-finition-item">
                    <strong class="sub-label">Façade</strong>
                    <p class="tech-paragraph">{dressing.caracteristiques_techniques.finition_produit.facade}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </main>

</Layout>

<script is:inline>
  // Script pour gérer l'ouverture/fermeture des dropdowns
  const dropdownToggles = document.querySelectorAll('.dropdown-toggle');

  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const dropdownItem = toggle.closest('.tech-item');
      dropdownItem.classList.toggle('active');
    });
  });
</script>


<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const swatches = document.querySelectorAll('.color-swatch');
    const colorLabel = document.getElementById('color-label') as HTMLElement | null;
    const previewCard = document.getElementById('texture-preview-card') as HTMLElement | null;
    const defaultSwatch = Array.from(swatches).find(s => s.getAttribute('title') === "Chêne naturel") as HTMLElement | null;

    // SI L'ÉLÉMENT N'EXISTE PAS SUR CETTE PAGE, ON QUITTE SILENCIEUSEMENT SANS ERREUR
    if (!previewCard) return;

    let activeSwatch: HTMLElement | null = null;

    if (defaultSwatch) {
      const defaultImg = defaultSwatch.getAttribute('data-value');
      const defaultTitle = defaultSwatch.getAttribute('title') || '';

      if (defaultImg && previewCard) {
        // 1. On applique directement le titre et la texture en arrière-plan
        if (colorLabel) colorLabel.textContent = defaultTitle;
        previewCard.style.backgroundImage = `url(${defaultImg})`;
        
        // 2. On fait descendre le rectangle instantanément ou via une transition douce
        gsap.to(previewCard, {
          y: "0%",
          duration: 0.45,
          ease: "power3.out"
        });

        // 3. On l'enregistre comme la pastille active en mémoire
        activeSwatch = defaultSwatch;
      }
    }

    function closePreview() {
      if (!previewCard) return;
      
      gsap.to(previewCard, {
        y: "-100%",
        duration: 0.3,
        ease: "power2.in",
        onComplete: () => {
          if (colorLabel) colorLabel.textContent = "";
          swatches.forEach(s => s.classList.remove('active-swatch'));
          activeSwatch = null;
        }
      });
    }

    function openOrChangePreview(currentSwatch: HTMLElement, imageUrl: string, title: string) {
      if (!previewCard) return;
      
      const tl = gsap.timeline();

      if (activeSwatch && activeSwatch !== currentSwatch) {
        tl.to(previewCard, {
          y: "-100%",
          duration: 0.2,
          ease: "power2.in",
          onComplete: () => {
            if (colorLabel) colorLabel.textContent = title;
            previewCard.style.backgroundImage = `url(${imageUrl})`;
          }
        });
      } else {
        if (colorLabel) colorLabel.textContent = title;
        previewCard.style.backgroundImage = `url(${imageUrl})`;
      }

      tl.to(previewCard, {
        y: "0%",
        duration: 0.45,
        ease: "power3.out"
      });

      swatches.forEach(s => s.classList.remove('active-swatch'));
      currentSwatch.classList.add('active-swatch');
      activeSwatch = currentSwatch;
    }

    swatches.forEach(swatch => {
      swatch.addEventListener('click', (e) => {
        const currentSwatch = e.currentTarget as HTMLElement;
        const imageUrl = currentSwatch.getAttribute('data-value');
        const title = currentSwatch.getAttribute('title') || '';

        if (!imageUrl) return;

        if (activeSwatch === currentSwatch) {
          closePreview();
        } else {
          openOrChangePreview(currentSwatch, imageUrl, title);
        }
      });
    });
  });
</script>


<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('main-visual') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn');
    const rail = document.getElementById('thumb-rail');
    const mask = document.getElementById('slider-mask');
    const prevBtn = document.getElementById('slide-prev');
    const nextBtn = document.getElementById('slide-next');

    if (!rail || !mask) return;

    // 1. INITIALISATION DU DRAGGABLE
    const dragInstance = Draggable.create(rail, {
      type: "x",
      bounds: mask,
      edgeResistance: 0.65,
      inertia: true,
    })[0]; // On récupère l'instance indexée 0

    // 2. LOGIQUE DE NAVIGATION VIA LES FLÈCHES
    // Largeur d'une miniature (9rem = 144px) + gap (0.5rem = 8px) = ~152px
    const stepWidth = 152; 

    function moveSlider(direction: 'next' | 'prev') {
      // On calcule la position cible X actuelle
      let currentX = gsap.getProperty(rail, "x") as number;
      let targetX = direction === 'next' ? currentX - stepWidth : currentX + stepWidth;

      // Force GSAP à respecter les limites physiques (bounds) du masque de défilement
      const minX = dragInstance.minX;
      const maxX = dragInstance.maxX;

      if (targetX < minX) targetX = minX;
      if (targetX > maxX) targetX = maxX;

      // Animation fluide du rail vers la nouvelle position
      gsap.to(rail, {
        x: targetX,
        duration: 0.4,
        ease: "power2.out",
        onUpdate: () => dragInstance.update() // Synchronise l'état interne du Drag de GSAP
      });
    }

    nextBtn?.addEventListener('click', () => moveSlider('next'));
    prevBtn?.addEventListener('click', () => moveSlider('prev'));

    // 3. LOGIQUE DE CHANGEMENT DE GALERIE (FADE)
    function updateGallery(newSrc: string | null) {
      if (!mainImg || !newSrc) return;
      
      gsap.to(mainImg, {
        opacity: 0,
        duration: 0.2,
        onComplete: () => {
          mainImg.src = newSrc;
          gsap.to(mainImg, { opacity: 1, duration: 0.2 });
        }
      });
    }

    thumbButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const currentBtn = e.currentTarget as HTMLElement;
        const img = currentBtn.getAttribute('data-full');
        
        updateGallery(img);

        thumbButtons.forEach(b => b.classList.remove('active-thumb'));
        currentBtn.classList.add('active-thumb');
      });
    });
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── SCROLL REVEAL ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
  });
</script>


