---
// src/pages/dressing/[id].astro
import Layout from '../../layouts/Layout.astro';
import '../../styles/details.css';
import { getDressingById } from '../../services/dressingService';
import type { DressingDto } from '../../types/dressing';

const { id } = Astro.params;

// Sécurité : si l'ID est absent de l'URL, on redirige vers la 404
if (!id) {
    return Astro.redirect('/404');
}

// Appel asynchrone sécurisé (id est forcé en string avec le '!')
const dressing: DressingDto | null = await getDressingById(id!);

// Si le dressing n'existe ni dans l'API ni dans le fallback local
if (!dressing) {
    return Astro.redirect('/404');
}

// Correction du calcul du prix final
const prixFinal = dressing.reduction 
  ? dressing.prixInitial * (1 - dressing.reduction / 100) 
  : dressing.prixInitial;

// Séparation sécurisée de la composition type
const compoText = dressing.caracteristiquesTechniques?.compositionType || '';
const milieuComposition = Math.ceil(compoText.length / 2);
const compoCol1 = compoText.slice(0, milieuComposition);
const compoCol2 = compoText.slice(milieuComposition);
---

<Layout title="Nos dressings | Art Of Design" theme="dark" pageBg="light">
  <main class="details-page">
    <div class="product-container">
      <nav class="breadcrumb">
        <a href="/">Accueil</a>
        <span>/</span>
        <a href="/dressing">dressings</a>
        {dressing.typeOuverture === "Fr" && (
          <>
            <span>/</span>
            <a href="/dressing#francaise">Dressing À la française</a>
          </>
        )}
        {dressing.typeOuverture === "C" && (
          <>
            <span>/</span>
            <a href="/dressing#coulissant">Dressing Coulissant</a>
          </>
        )}
        <span>/</span>
        <span class="active-crumb-text">{dressing.nom}</span>
      </nav>

      <div class="main-product-grid">    
        <div class="visuals-zone">

          <!-- Image principale -->
          <div class="main-visual-wrapper">
            {dressing.images && dressing.images.length > 0 ? (
              <img 
                id="main-visual" 
                src={dressing.images.find(img => img.estPrincipale)?.url || dressing.images[0].url} 
                alt={dressing.nom} 
                class="main-img" 
              />
            ) : (
              <img id="main-visual" src="/images/placeholder.jpg" alt={dressing.nom} class="main-img" />
            )}
            <div class="visual-overlay"></div>
          </div>

          <!-- Slider des miniatures corrigé (plus de double map imbriqué) -->
          <div class="slider-wrapper-relative">
            <button id="slide-prev" class="slider-arrow prev-arrow" aria-label="Précédent">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
            </button>

            <div class="slider-container" id="slider-mask">
              <div class="thumbnails-slider-rail" id="thumb-rail">
                {dressing.images?.map((img, index) => (
                  <button class={`thumb-btn ${index === 0 ? 'active-thumb' : ''}`} data-full={img.url}>
                    <img src={img.url} alt={`${dressing.nom} - ${index + 1}`} class="thumb" />
                  </button>
                ))}
              </div>
            </div>

            <button id="slide-next" class="slider-arrow next-arrow" aria-label="Suivant">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>

        </div>

        <div class="details-zone">
          <div class="header-details">
            <span class="brand-badge">Exclusivité AD dressing</span>
            <h1 class="product-title">{dressing.nom}</h1>
            
            <div class="price-wrapper">
              {dressing.reduction > 0 ? (
                <div class="price-flex">
                  <p class="price-old">{dressing.prixInitial} TTC</p>
                  <p class="price-current">{prixFinal} TTC</p>                
                  <span class="discount-tag">-{dressing.reduction}%</span>
                </div>
              ) : (
                <p class="price-current">{dressing.prixInitial} TTC</p>
              )}
            </div>
          </div>
          
          <div class="specs-block">
            <p>
              <strong class="spec-paragraph">Dimensions Module Dressing</strong> <br /> 
              Largeur {dressing.dimensions?.largeur} <br /> 
              Hauteur {dressing.dimensions?.hauteur} <br /> 
              Profondeur {dressing.dimensions?.profondeur}
            </p>
          </div>

          <div class="nuancier-block">
            <div class="nuancier-header">
              <h3 class="nuancier-title">Nuancier disponible</h3>
              <span id="color-label" class="color-current-name"></span>
            </div>

            <div class="swatches-row">
              {dressing.couleurs?.map((v) => (
                <button 
                  class="color-swatch"
                  style={`background-image: url(${v.imagePresentationUrl || ''}); background-size: cover; background-position: center;`}
                  data-value={v.imagePresentationUrl}
                  title={v.nom}
                >
                </button>
              ))}
            </div>

            <div class="preview-card-wrapper">
              <div id="texture-preview-card" class="preview-card-el"></div>
            </div>
          </div>

          <div class="cta-wrapper">
            <a href="/#contact" class="btn-text-flip"> 
              <span class="text-default">Réserver mon étude gratuite</span>
              <span class="text-hover">Réserver mon étude gratuite</span>
            </a> 
          </div>
        </div>
      </div>

      <div class="technical-section">
        <h3 class="technical-main-title">Caractéristiques techniques des éléments</h3>
        
        <div class="tech-dropdowns">
          <div class="tech-item dropdown active" id="dropdown-composition">
            <button class="tech-header dropdown-toggle">
              <span class="tech-item-number reveal"></span>
              <h4>Composition type</h4>
              <div class="dropdown-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </button>
            <div class="tech-content dropdown-pane">
              <div class="tech-content-inner">
                <div class="tech-composition-cols">
                  <ul>
                    <li>Composition : {dressing.caracteristiquesTechniques?.compositionType}</li>
                    <li>Caisson : {dressing.caracteristiquesTechniques?.caisson}</li>
                    <li>Façade : {dressing.caracteristiquesTechniques?.facade}</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="tech-item dropdown" id="dropdown-finition">
            <button class="tech-header dropdown-toggle">
              <span class="tech-item-number"></span>
              <h4>Finition produit</h4>
              <div class="dropdown-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </button>
            <div class="tech-content dropdown-pane">
              <div class="tech-content-inner">
                <div class="tech-finition-details">
                  <div class="tech-finition-item">
                    <strong class="sub-label">Caisson</strong>
                    <p class="tech-paragraph">{dressing.caracteristiquesTechniques?.caisson}</p>
                  </div>
                  <div class="tech-finition-item">
                    <strong class="sub-label">Façade</strong>
                    <p class="tech-paragraph">{dressing.caracteristiquesTechniques?.facade}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const dropdownItem = toggle.closest('.tech-item');
      dropdownItem.classList.toggle('active');
    });
  });
</script>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const swatches = document.querySelectorAll('.color-swatch');
    const colorLabel = document.getElementById('color-label') as HTMLElement | null;
    const previewCard = document.getElementById('texture-preview-card') as HTMLElement | null;

    if (!previewCard) return;
    let activeSwatch: HTMLElement | null = null;

    swatches.forEach(swatch => {
      swatch.addEventListener('click', (e) => {
        const currentSwatch = e.currentTarget as HTMLElement;
        const imageUrl = currentSwatch.getAttribute('data-value');
        const title = currentSwatch.getAttribute('title') || '';

        if (!imageUrl) return;

        if (activeSwatch === currentSwatch) {
          gsap.to(previewCard, {
            y: "-100%",
            duration: 0.3,
            ease: "power2.in",
            onComplete: () => {
              if (colorLabel) colorLabel.textContent = "";
              currentSwatch.classList.remove('active-swatch');
              activeSwatch = null;
            }
          });
        } else {
          if (colorLabel) colorLabel.textContent = title;
          previewCard.style.backgroundImage = `url(${imageUrl})`;
          gsap.to(previewCard, {
            y: "0%",
            duration: 0.45,
            ease: "power3.out"
          });
          swatches.forEach(s => s.classList.remove('active-swatch'));
          currentSwatch.classList.add('active-swatch');
          activeSwatch = currentSwatch;
        }
      });
    });
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('main-visual') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn');
    const rail = document.getElementById('thumb-rail');
    const mask = document.getElementById('slider-mask');
    const prevBtn = document.getElementById('slide-prev');
    const nextBtn = document.getElementById('slide-next');

    if (!rail || !mask) return;

    const dragInstance = Draggable.create(rail, {
      type: "x",
      bounds: mask,
      edgeResistance: 0.65,
      inertia: true,
    })[0];

    const stepWidth = 152; 

    function moveSlider(direction: 'next' | 'prev') {
      let currentX = gsap.getProperty(rail, "x") as number;
      let targetX = direction === 'next' ? currentX - stepWidth : currentX + stepWidth;

      const minX = dragInstance.minX;
      const maxX = dragInstance.maxX;

      if (targetX < minX) targetX = minX;
      if (targetX > maxX) targetX = maxX;

      gsap.to(rail, {
        x: targetX,
        duration: 0.4,
        ease: "power2.out",
        onUpdate: () => dragInstance.update()
      });
    }

    nextBtn?.addEventListener('click', () => moveSlider('next'));
    prevBtn?.addEventListener('click', () => moveSlider('prev'));

    thumbButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const currentBtn = e.currentTarget as HTMLElement;
        const imgUrl = currentBtn.getAttribute('data-full');
        
        if (mainImg && imgUrl) {
          gsap.to(mainImg, {
            opacity: 0,
            duration: 0.2,
            onComplete: () => {
              mainImg.src = imgUrl;
              gsap.to(mainImg, { opacity: 1, duration: 0.2 });
            }
          });
        }

        thumbButtons.forEach(b => b.classList.remove('active-thumb'));
        currentBtn.classList.add('active-thumb');
      });
    });
  });
</script>