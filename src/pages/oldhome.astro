<script is:inline>
  // On utilise une fonction auto-exécutée pour isoler le scope
  (() => {
    const initForm = () => {
      const form = document.getElementById('ajax-contact-form');
      const status = document.getElementById('form-status');
      
      if (!form || !status) return;

      form.addEventListener('submit', async (e) => {
        // Bloque immédiatement la redirection native
        e.preventDefault(); 
        e.stopPropagation();

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        // Affichage de l'état de chargement
        status.style.display = 'block';
        status.className = 'form-status-message sending';
        status.innerText = 'Transmission de votre projet...';

        const data = new FormData(form);

        try {
          const response = await fetch(form.action, {
            method: form.method,
            body: data,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            status.className = 'form-status-message success';
            status.innerText = 'Votre message a bien été transmis. Notre équipe vous répondra sous 48 heures.';
            form.reset();
          } else {
            const responseData = await response.json();
            status.className = 'form-status-message error';
            status.innerText = responseData.error || 'Une erreur est survenue.';
            if (submitBtn) submitBtn.disabled = false;
          }
        } catch (error) {
          status.className = 'form-status-message error';
          status.innerText = 'Impossible de joindre le serveur. Veuillez réessayer.';
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    };

    // Gestion du cycle de vie Astro (DOMContentLoaded + transitions de pages éventuelles)
    document.addEventListener('DOMContentLoaded', initForm);
    initForm(); // Exécution immédiate au cas où le DOM est déjà prêt
  })();
</script>