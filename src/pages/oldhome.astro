    // ── LOADER ──
    const loader = document.getElementById('loader');
    setTimeout(() => {
      loader.style.transition = 'opacity 0.8s ease';
      loader.style.opacity = '0';
      setTimeout(() => loader.style.display = 'none', 800);
    }, 2400);

    // ── NAV SCROLL ──
    const nav = document.getElementById('navbar');
    if (nav) {
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 60);
      });
    }

    // ── SCROLL REVEAL ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));

    // ── SWIPERS PRODUITS ──
    const commonConfig = {
      spaceBetween: 24,
      loop: true,
      breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
      slidesPerView: 1,
    };

    new Swiper('.cuisineSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-cuisine', prevEl: '.swiper-prev-cuisine' } });
    new Swiper('.dressingSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-dressing', prevEl: '.swiper-prev-dressing' } });
    new Swiper('.meubleSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-meuble', prevEl: '.swiper-prev-meuble' } });
    new Swiper('.projetSwiper', { ...commonConfig, navigation: { nextEl: '.swiper-next-projet', prevEl: '.swiper-prev-projet' } });

  });
</script>


<script is:inline>
  function initHorizontalScroll() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      
      gsap.registerPlugin(ScrollTrigger);

      // On récupère les éléments des deux sections
      const philosophySection = document.querySelector('#philosophy-premium');
      const track = document.querySelector('.categories-horizontal-track');
      const container = document.querySelector('#categories-pin-container');
      const cards = gsap.utils.toArray('.cat-card'); 
      
      // Sécurité : si l'un des blocs manque, on ne fait rien
      if (!track || !container || cards.length === 0) return;

      // ==========================================
      // AJOUT : ÉTAPE 0 - L'effet rideau (Recouvrement)
      // ==========================================
      if (philosophySection) {
        ScrollTrigger.create({
          trigger: philosophySection,
          start: "bottom bottom",    
          end: "+=100%",    
          pin: true,
          pinSpacing: false, // Laisse la section catégorie monter par-dessus
          invalidateOnRefresh: true,
        });
      }

      // ==========================================
      // TON CODE EXISTANT (Inchangé et protégé)
      // ==========================================
      const getScrollAmount = () => {
        return -(track.scrollWidth - window.innerWidth);
      };

      gsap.to(track, {
        x: getScrollAmount,
        ease: "none", 
        scrollTrigger: {
          trigger: container,
          start: "bottom bottom",      
          end: () => `+=${track.scrollWidth}`, 
          pin: true,             
          scrub: 1,              
          invalidateOnRefresh: true,
          /*
          snap: {
            snapTo: 1 / (cards.length - 1), 
            duration: { min: 0.2, max: 0.6 }, 
            ease: "power1.inOut"
          }
            */
        }
      });

      ScrollTrigger.refresh();
    }
  }

  // Initialisation au chargement de la page et des médias
  window.addEventListener('load', () => {
    setTimeout(initHorizontalScroll, 250);
  });
</script>

<script is:inline>
  // --- ANIMATION INTERACTIVE DU SLIDER AVANT/APRÈS ---
  const slider = document.querySelector('#project-slider');
    if (slider) {
      const moveSlider = (e) => {
        // Récupère les coordonnées du slider à l'écran
        const rect = slider.getBoundingClientRect();
        // Calcule la position X de la souris par rapport au conteneur (en %)
        let x = e.clientX - rect.left;
        let percentage = (x / rect.width) * 100;
        
        // Sécurité pour pas que ça sorte du cadre (entre 0% et 100%)
        if (percentage < 0) percentage = 0;
        if (percentage > 100) percentage = 100;
        
        // Injecte la valeur directement dans le CSS
        slider.style.setProperty('--slider-pos', `${percentage}%`);
      };

      // S'active simplement au mouvement de la souris sur l'image
      slider.addEventListener('mousemove', moveSlider);
      // Support pour les écrans tactiles sur mobile
      slider.addEventListener('touchmove', (e) => moveSlider(e.touches[0]));
    }

    function initProcessContactScroll() {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        
        gsap.registerPlugin(ScrollTrigger);

        const processSection = document.querySelector('#process-premium');
        const contactSection = document.querySelector('#contact');
        
        if (!processSection || !contactSection) return;

        // EFFET RIDEAU CORRIGÉ
        ScrollTrigger.create({
          trigger: processSection,
          start: "bottom bottom", // MODIFICATION : On attend que le BAS du process touche le BAS de l'écran
          end: "+=100%",          // Laisse un temps de pause ou d'ancrage
          pin: true,
          pinSpacing: false,      // Permet au contact de glisser par-dessus
          invalidateOnRefresh: true,
        });

        ScrollTrigger.refresh();
      }
    }

    window.addEventListener('load', () => {
      setTimeout(initProcessContactScroll, 300);
    });
</script>


