---
import Layout from '../layouts/Layout.astro';
import Process from '../components/Process.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projetsData from '../data/projets.json';

const sections = [
  { id: "forme-i", label: "Dressing Forme I", valeur: "I" },
  { id: "forme-l", label: "Dressing Forme L", valeur: "L" },
  { id: "aLaFr", label: "A La Française", valeur: "Fr" },
  { id: "coulissant", label: "Projets", valeur: "C" }
];

// Mélange des projets pour la galerie globale "Tous"
const tousLesProjetsMixes = [...projetsData].sort(() => 0.5 - Math.random());
---

<Layout title="Nos Projets Réalisés | Art Of Design">
  <main class="luxury-catalog">
    
    <section class="luxury-hero">
      <div class="luxury-hero-bg">
        <img src="/images/1.jpg" alt="Art Of Design Haute Cuisine" class="luxury-hero-img" />
        <div class="luxury-hero-overlay"></div>
      </div>
      
      <div class="luxury-hero-content">
        <h1 class="luxury-main-title">du 3d au réel</h1>
        <p class="luxury-text">Chaque projet est une histoire. Découvrez comment nous transformons une idée en espace de vie exceptionnel — <br/>de la première esquisse à la pose finale.</p>
        <p class="luxury-subtitle">Réalisations</p>
      </div>
    </section>

    <div class="catalog-filter-bar">
      <nav class="luxury-breadcrumb">
        <a href="/">Accueil</a>
        <span class="separator">/</span>
        <span class="current">Projets</span>
      </nav>
    </div>

    <div class="luxury-content-wrapper">
      <Process />

      <div class="portfolio-container">
        
        <div class="section-header reveal visible" style="margin-bottom:3rem; padding: 0 4rem;">
          <div class="section-eyebrow">Portfolio</div>
          <h2 class="section-title">Nos réalisations d'exception</h2>
          <p class="section-desc">À gauche : le rendu 3D validé par le client. À droite : la réalisation finale dans son intérieur.</p>
        </div>

        <section id="all-gallery" class="projects-list data-catalog-section" style="display: block; opacity: 1;">
          <div id="projects-list">
            {tousLesProjetsMixes.map((item) => (
              <ProjectCard 
                id={item.id}
                nom={item.nom}
                description={item.description}
                image3d={item.image3d}
                image={item.image}
                forme={item.forme}
              />
            ))}
          </div>
        </section>

        {sections.map((section) => {
          const projetsFiltrés = projetsData.filter(item => item.forme === section.valeur);

          return projetsFiltrés.length > 0 && (
            <section id={section.id} class="projects-list data-catalog-section" style="display: none; opacity: 0;">
              <div id="projects-list">
                {projetsFiltrés.map((item) => (
                  <ProjectCard 
                    id={item.id}
                    nom={item.nom}
                    description={item.description}
                    image3d={item.image3d}
                    image={item.image}
                    forme={item.forme}
                  />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>

    <div class="anatomies">
      <div class="anatomie-text">
        <h1 class="titre-anatomie">Vous ne savez pas quelle forme choisir ?</h1>
        <p class="text-titre-anatomie">Consultez notre guide interactif des formes de cuisines.</p>
      </div>
      <a href={`/cuisines-infos`} class="btn-text-flip"> 
        <span class="text-default">Explorer l'anatomie</span>
        <span class="text-hover">Explorer l'anatomie</span>                
      </a>    
    </div>

  </main>
</Layout>

<script>
  const setupFilters = () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const sections = document.querySelectorAll('.data-catalog-section');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const targetFilter = button.getAttribute('data-filter');

        buttons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        sections.forEach(section => {
          const sectionElement = section as HTMLElement;
          const isAllTarget = targetFilter === 'all' && sectionElement.id === 'all-gallery';
          const isSpecificTarget = sectionElement.id === targetFilter;

          if (isAllTarget || isSpecificTarget) {
            sectionElement.style.display = 'block';
            setTimeout(() => {
              sectionElement.style.opacity = '1';
              sectionElement.style.transform = 'translateY(0)';
            }, 50);
          } else {
            sectionElement.style.opacity = '0';
            sectionElement.style.transform = 'translateY(15px)';
            setTimeout(() => {
              sectionElement.style.display = 'none';
            }, 350); 
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', setupFilters);
</script>

<style is:global>
  #process-premium {
    padding: 0rem 4rem;
    background-color: #333232;
  }
  
  .portfolio-container {
    padding-top: 6rem;
    background-color: #0b0b0b;
  }
</style>