---
import Layout from '../layouts/Layout.astro';
import Process from '../components/Process.astro';
import ProjectCard, { type CatalogueItem } from '../components/ProjectCard.astro';
import projetsData from '../data/projets.json';
import ImageGallery from '../components/ImageGallery.astro';
import '../styles/cuisines.css'; 
import '../styles/projets.css'; 

const tousLesProjetsMixes = [...projetsData].sort(() => 0.5 - Math.random());

// Extraction sécurisée des images réelles uniquement (avec correction du type TS)
const galleryImages = tousLesProjetsMixes.flatMap((projet) => {
  return ((projet.catalogue_images || []) as CatalogueItem[])
    .filter((item): item is { image: string } => 'image' in item)
    .map((item) => ({
      src: item.image,
      alt: `${projet.nom} - Photo du projet`,
      title: projet.nom,
      category: projet.categorie || 'Projet Réel'
    }));
});
---

<!-- Import du CSS Swiper au niveau global -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<Layout title="Nos Projets Réalisés | Art Of Design">
  <main class="luxury-catalog">
    
    <section class="luxury-hero">
      <div class="luxury-hero-bg">
        <img src="/images/autres/1.jpg" alt="Art Of Design Haute Cuisine" class="luxury-hero-img" />
        <div class="luxury-hero-overlay"></div>
      </div>
      
      <div class="luxury-hero-content">
        <h1 class="luxury-main-title">du 3d au réel</h1>
        <p class="luxury-text">Chaque projet est une histoire. Découvrez comment nous transformons une idée en espace de vie exceptionnel — <br/>de la première esquisse à la pose finale.</p>
        <p class="luxury-subtitle">Réalisations</p>
      </div>
    </section>

    <div class="catalog-filter-bar">
      <nav class="luxury-breadcrumb">
        <a href="/">Accueil</a>
        <span class="separator">/</span>
        <span class="current">Projets</span>
      </nav>
    </div>

    <div class="luxury-content-wrapper">
      <!--<Process /> -->

      <div class="portfolio-container">
        
        <div class="section-header reveal visible" style="margin-bottom:3rem; padding: 0 4rem;">
          <div class="section-header-eyebrow">Portfolio</div>
          <h2 class="section-header-title">Nos réalisations d'exception</h2>
          <p class="section-desc">À gauche : le rendu 3D validé par le client. À droite : la réalisation finale dans son intérieur.</p>
        </div>

        <section id="all-gallery" class="projects-list data-catalog-section" style="display: block; opacity: 1;">
          <div class="projects-vertical-list">
            {projetsData.map((projet) => (
              <ProjectCard 
                id={projet.id}
                nom={projet.nom}
                description={projet.description}
                categorie={projet.categorie}
                catalogue_images={projet.catalogue_images}
              />
            ))}
          </div>
        </section>
      </div>
    </div>

    <div>
      <ImageGallery images={galleryImages} />
    </div>

    <div class="anatomies">
      <div class="anatomie-text">
        <h1 class="titre-anatomie">Vous ne savez pas quelle forme choisir ?</h1>
        <p class="text-titre-anatomie">Consultez notre guide interactif des formes de cuisines.</p>
      </div>
      <a href={`/cuisines-infos`} class="btn-text-flip"> 
        <span class="text-default">Lire Le Guide <span class="arrow">→</span></span>
        <span class="text-hover">Lire Le Guide <span class="arrow">→</span></span>                
      </a>    
    </div>

  </main>
</Layout>

<style is:global>
  #process-premium {
    padding: 0rem 4rem;
  }

  .portfolio-container {
    padding-top: 6rem;
    background-color: #0b0b0b;
  }

  .process-header {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding-bottom: 2rem;
  }
</style>